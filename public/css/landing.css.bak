
/* ==================================================
   SIPRESKA LANDING PAGE
   Purple Gradient • Lavender • Champagne Gold
================================================== */

:root {
    --purple: #8052cf;
    --purple-dark: #57358b;
    --purple-deep: #392653;
    --purple-mid: #a17be8;
    --purple-light: #eee5ff;
    --purple-pale: #f8f4ff;

    --gold: #c9a45e;
    --gold-dark: #97743b;
    --gold-light: #f7efd9;
    --gold-pale: #fcf8ef;

    --text: #453752;
    --muted: #80728f;
    --white: #ffffff;
    --border: #e5daf2;

    --shadow-sm: 0 5px 22px rgba(87, 53, 139, .07);
    --shadow-md: 0 12px 28px rgba(87, 53, 139, .12);
    --shadow-lg: 0 16px 36px rgba(87, 53, 139, .16);

    --radius: 16px;
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
}

body {
    margin: 0;
    background: #fbf9fe;
    color: var(--text);
    font-family: "Segoe UI", Arial, sans-serif;
    line-height: 1.6;
}

body,
button,
input,
select,
textarea {
    font-family: "Segoe UI", Arial, sans-serif;
}

a {
    color: inherit;
}

img {
    max-width: 100%;
}

button {
    font: inherit;
}

/* ==================================================
   NAVBAR — SIPRESKA KIRI, MENU KANAN
================================================== */

.site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    background: rgba(255, 255, 255, .88);
    border-bottom: 1px solid rgba(229, 218, 242, .75);
    box-shadow: 0 8px 30px rgba(57, 38, 83, .06);
    backdrop-filter: blur(18px);
}

.nav-wrap {
    width: 92%;
    max-width: 1440px;
    min-height: 82px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
}

.brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
    text-decoration: none;
    transition: opacity 0.2s ease;
}

.brand:hover {
    opacity: 0.92;
}

.brand-logo {
    width: 38px;
    height: 38px;
    object-fit: contain;
    flex-shrink: 0;
    filter: drop-shadow(0 4px 10px rgba(67, 39, 101, 0.12));
    transition: transform 0.2s ease;
}

.brand:hover .brand-logo {
    transform: scale(1.05);
}

.brand-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    line-height: 1.15;
}

.brand-title {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.6px;
    color: var(--purple-dark, #432765);
    margin: 0;
    line-height: 1;
}

.brand-dot {
    color: var(--gold, #c9a227);
    font-weight: 900;
}

.brand-subtitle {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 1.3px;
    text-transform: uppercase;
    color: #837299;
    margin-top: 3px;
    line-height: 1;
}

@media (max-width: 600px) {
    .brand-subtitle {
        display: none;
    }
    .brand-title {
        font-size: 21px;
    }
    .brand-logo {
        width: 32px;
        height: 32px;
    }
}

.main-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(14px, 1.8vw, 27px);
    margin-left: auto;
}

.main-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 25px 0 22px;
    color: #57466c;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: color .2s ease;
}

.main-nav a svg {
    width: 17px;
    height: 17px;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.main-nav a:hover,
.main-nav a.active {
    color: var(--gold-dark);
}

.main-nav a.active::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 3px;
    border-radius: 3px 3px 0 0;
    background: linear-gradient(90deg, var(--gold), #e4c87f);
}

.nav-toggle {
    display: none;
    padding: 8px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--purple-pale);
    color: var(--purple-dark);
    font-size: 22px;
    cursor: pointer;
}

/* ==================================================
   HERO SLIDER
================================================== */

.hero-slider {
    position: relative;
    isolation: isolate;
    width: min(1600px, calc(100% - 56px));
    height: clamp(500px, 61vw, 680px);
    min-height: 500px;
    margin: 26px auto 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, .22);
    border-radius: 30px;
    background: var(--purple-deep);
    box-shadow: 0 24px 65px rgba(57, 38, 83, .2);
}

.hero-slider .slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity .6s ease, visibility .6s ease;
}

.hero-slider .slide.active {
    z-index: 1;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
}

.hero-slider .slide > img {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
    transform: scale(1.08);
    filter: saturate(1.12) contrast(1.04);
    transition: transform 8s cubic-bezier(.2, .65, .3, 1), filter 1s ease;
}

.hero-slider .slide.active > img {
    transform: scale(1);
    filter: saturate(1.08) contrast(1.03);
}

.slide-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    background: linear-gradient(
        105deg,
        rgba(37, 24, 58, .86) 0%,
        rgba(66, 43, 99, .66) 47%,
        rgba(63, 47, 74, .12) 100%
    );
}

.slide-overlay::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 5px;
    background: linear-gradient(
        90deg,
        var(--purple-mid),
        #e0c789 48%,
        var(--gold) 70%,
        transparent 100%
    );
    pointer-events: none;
}

.slide-content {
    position: relative;
    z-index: 2;
    width: 86%;
    max-width: 1320px;
    margin: 0 auto;
    color: var(--white);
}

.eyebrow {
    display: inline-block;
    margin-bottom: 15px;
    color: #ead5a0;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.4px;
    text-transform: uppercase;
}

.eyebrow.dark {
    color: var(--purple);
}

.slide-content h1 {
    max-width: 720px;
    margin: 0 0 20px;
    color: var(--white);
    font-size: clamp(40px, 5.4vw, 68px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -1px;
    text-shadow: 0 3px 22px rgba(0, 0, 0, .24);
}

.slide-content p {
    max-width: 570px;
    margin: 0 0 30px;
    color: rgba(255, 255, 255, .92);
    font-size: 16px;
    line-height: 1.8;
}

/* ==================================================
   BUTTONS
================================================== */

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 12px 24px;
    border: 1px solid transparent;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    transition: all .2s ease;
}

.btn-primary {
    border-color: #d8bd80;
    background: linear-gradient(
        120deg,
        #6e47b1,
        #8d62dc 60%,
        #a17be8
    );
    color: #ffffff;
    box-shadow: 0 7px 20px rgba(65, 35, 111, .25);
}

.btn-primary:hover {
    transform: translateY(-2px);
    border-color: #e0c789;
    background: linear-gradient(
        120deg,
        #57358b,
        #8052cf
    );
    color: #ffffff;
    box-shadow: 0 9px 22px rgba(87, 53, 139, .25);
}

.btn-secondary {
    border-color: #d9c4f5;
    background: #ffffff;
    color: var(--purple-dark);
}

.btn-secondary:hover {
    transform: translateY(-2px);
    background: var(--purple-light);
    color: var(--purple-dark);
}

.hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 26px;
}

/* ==================================================
   SLIDER CONTROLS
================================================== */

.slider-btn {
    position: absolute;
    top: 50%;
    z-index: 5;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translateY(-50%);
    border: 1px solid rgba(255, 255, 255, .45);
    border-radius: 50%;
    background: rgba(57, 38, 83, .42);
    color: #ffffff;
    font-size: 29px;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: background .2s ease;
}

.slider-btn:hover {
    border-color: #e0c789;
    background: rgba(111, 79, 151, .90);
}

.slider-btn.prev {
    left: 22px;
}

.slider-btn.next {
    right: 22px;
}

.slider-dots {
    position: absolute;
    right: 0;
    bottom: 24px;
    left: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
}

.slider-dots button,
.slider-dots .dot,
.slider-dots span {
    width: 9px;
    height: 9px;
    padding: 0;
    border: 0;
    border-radius: 20px;
    background: rgba(255, 255, 255, .65);
    cursor: pointer;
}

.slider-dots button.active,
.slider-dots .dot.active,
.slider-dots span.active {
    width: 27px;
    background: #e5cb83;
}

.catalog-back {
    margin: 68px auto 0;
    padding-bottom: 0;
}

.catalog-section {
    padding-bottom: clamp(150px, 20vh, 240px);
}

/* ==================================================
   SECTIONS AND HEADINGS
================================================== */

.section {
    width: 100%;
    margin: 0;
    padding: 88px 0;
    background:
        radial-gradient(
            ellipse at top right,
            rgba(161, 123, 232, .08),
            transparent 36%
        ),
        #ffffff;
}

.section.section-soft {
    background:
        radial-gradient(
            ellipse at 5% 10%,
            rgba(201, 164, 94, .12),
            transparent 32%
        ),
        linear-gradient(
            135deg,
            #f9f5ff,
            #eee5fb 58%,
            #f8f0e2
        );
}

.section-heading {
    width: 88%;
    max-width: 1200px;
    margin: 0 auto 34px;
}

.section-heading.center {
    text-align: center;
}

.section-heading .eyebrow {
    margin-bottom: 9px;
}

.section-heading h2 {
    margin: 0 0 13px;
    color: var(--purple-dark);
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -.6px;
}

.section-heading.center h2::after,
.section-heading:not(.center) h2::after {
    content: "";
    display: block;
    width: 46px;
    height: 3px;
    margin-top: 14px;
    border-radius: 10px;
    background: linear-gradient(
        90deg,
        var(--purple),
        var(--purple-mid),
        var(--gold)
    );
}

.section-heading.center h2::after {
    margin-right: auto;
    margin-left: auto;
}

.section-heading p {
    max-width: 680px;
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.8;
}

.section-heading.center p {
    margin-right: auto;
    margin-left: auto;
}

/* ==================================================
   STATISTICS
================================================== */

.stats-grid {
    width: 88%;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
}

.stat-box {
    position: relative;
    overflow: hidden;
    padding: 21px 24px;
    border: 1px solid #e7e2ed;
    border-radius: 14px;
    background: #ffffff;
    text-align: left;
    box-shadow: 0 4px 14px rgba(57, 38, 83, .045);
    transition: border-color .2s ease, box-shadow .2s ease;
}

.stat-box::before {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 3px;
    background: #9a79c5;
}

.stat-box:nth-child(1)::before { background: #c9a45e; }
.stat-box:nth-child(2)::before { background: #8052cf; }
.stat-box:nth-child(3)::before { background: #568c70; }
.stat-box:nth-child(4)::before { background: #bd6670; }

.stat-box:hover {
    border-color: #d7c9e7;
    box-shadow: 0 8px 22px rgba(57, 38, 83, .08);
}

.stat-value {
    margin-bottom: 3px;
    color: var(--purple);
    font-size: 32px;
    font-weight: 700;
    line-height: 1.2;
    overflow-wrap: anywhere;
}

.stat-label {
    display: block;
    margin-bottom: 5px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
}

.stat-caption {
    margin: 0;
    color: #8b8197;
    font-size: 12px;
    line-height: 1.5;
}

.stats-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
}

/* ==================================================
   COMPETITION CARDS
================================================== */

.competition-grid {
    width: 88%;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
}

.competition-card {
    display: block;
    min-width: 0;
    overflow: hidden;
    border: 1px solid #e2d5f2;
    border-radius: 20px;
    background: #ffffff;
    color: inherit;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: transform .2s ease, box-shadow .2s ease;
}

.competition-card:hover {
    transform: translateY(-4px);
    border-color: var(--gold);
    box-shadow: var(--shadow-md);
}

.competition-image {
    position: relative;
    width: 100%;
    height: 220px;
    overflow: hidden;
    background: var(--purple-light);
}

.competition-image::after {
    content: "";
    position: absolute;
    inset: 35% 0 0;
    background: linear-gradient(180deg, transparent, rgba(42, 27, 66, .2));
    pointer-events: none;
}

.competition-image img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    filter: saturate(1.08) contrast(1.03);
    transition: transform .55s cubic-bezier(.2, .65, .3, 1), filter .35s ease;
}

.competition-card:hover .competition-image img {
    transform: scale(1.08);
    filter: saturate(1.2) contrast(1.05);
}

.competition-body {
    padding: 20px;
    background: linear-gradient(
        180deg,
        #ffffff,
        #f7f2ff
    );
}

.competition-body h3 {
    margin: 0 0 8px;
    color: var(--purple-dark);
    font-size: 17px;
}

.competition-body p {
    margin: 0 0 14px;
    color: var(--muted);
    font-size: 13px;
}

.competition-body strong {
    display: inline-block;
    padding: 5px 10px;
    border: 1px solid #ead8ad;
    border-radius: 20px;
    background: #f8f0dd;
    color: #86652f;
    font-size: 13px;
}

/* ==================================================
   CHART
================================================== */

.chart-card {
    width: 88%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 28px;
    border: 1px solid #e2d5f2;
    border-radius: 18px;
    background:
        radial-gradient(
            ellipse at top right,
            rgba(161, 123, 232, .10),
            transparent 42%
        ),
        #ffffff;
    box-shadow: var(--shadow-sm);
}

.chart-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 15px 24px;
    margin-bottom: 27px;
}

.chart-legend span {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 12px;
}

.legend-box {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 3px;
}

.legend-box.internasional { background: var(--gold); }
.legend-box.nasional { background: var(--purple); }
.legend-box.regional { background: var(--purple-mid); }
.legend-box.universitas { background: #d8c7f4; }

.bar-chart {
    display: grid;
    grid-template-columns: 45px minmax(0, 1fr);
    gap: 15px;
    min-width: 0;
}

.chart-y-axis {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-bottom: 28px;
    color: #968ba5;
    font-size: 11px;
    text-align: right;
}

.chart-area {
    position: relative;
    min-width: 0;
    height: 300px;
}

.chart-grid-lines {
    position: absolute;
    inset: 0 0 27px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    pointer-events: none;
}

.chart-grid-lines span {
    width: 100%;
    border-top: 1px dashed #e5daf2;
}

.bar-groups {
    position: relative;
    z-index: 1;
    height: 100%;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 12px;
}

.bar-group {
    min-width: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    gap: 10px;
}

.bars {
    width: 100%;
    height: calc(100% - 28px);
    min-width: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 4px;
}

.bar {
    width: 16%;
    max-width: 19px;
    min-width: 4px;
    min-height: 3px;
    border-radius: 4px 4px 0 0;
}

.bar.internasional {
    background: linear-gradient(180deg, #e0c789, #b58d45);
}

.bar.nasional {
    background: linear-gradient(180deg, #b49aea, var(--purple));
}

.bar.regional { background: var(--purple-mid); }
.bar.universitas { background: #d8c7f4; }

.bar-group > span {
    color: #817590;
    font-size: 11px;
}

.chart-caption {
    margin: 18px 0 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.7;
}

/* ==================================================
   PEOPLE CARDS
================================================== */

.people-grid {
    width: 88%;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
}

.person-card {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    min-width: 0;
    padding: 23px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #ffffff;
    box-shadow: var(--shadow-sm);
}

.person-avatar {
    width: 52px;
    height: 52px;
    flex: 0 0 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #dfd0f6;
    border-radius: 14px;
    background: linear-gradient(135deg, #eee5ff, #e7d9ff);
    color: var(--purple-dark);
    font-size: 16px;
    font-weight: 800;
}

.person-body { min-width: 0; }

.person-body h3 {
    margin: 0 0 5px;
    color: var(--purple-dark);
    font-size: 15px;
    line-height: 1.4;
}

.person-body p {
    margin: 0 0 11px;
    color: var(--muted);
    font-size: 12px;
}

.mini-badge {
    display: inline-block;
    margin-bottom: 11px;
    padding: 5px 10px;
    border: 1px solid #ead8ad;
    border-radius: 20px;
    background: linear-gradient(110deg, #eee5ff, #f8f0dd);
    color: var(--purple-dark);
    font-size: 11px;
    font-weight: 700;
}

.person-body strong {
    display: block;
    color: #5b506a;
    font-size: 12px;
    line-height: 1.6;
}

/* ==================================================
   RECENT ACHIEVEMENTS
================================================== */

.split-heading {
    width: 88%;
    max-width: 1200px;
    margin: 0 auto 34px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
}

.split-heading .section-heading {
    width: auto;
    max-width: none;
    margin: 0;
}

.text-link {
    flex-shrink: 0;
    padding: 9px 0;
    color: var(--purple);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
}

.text-link:hover { color: var(--gold-dark); }

.recent-grid {
    width: 88%;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
}

.recent-grid.recent-grid-compact {
    max-width: 1240px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 390px));
    justify-content: center;
    gap: 24px;
}

.catalog-table-wrap {
    width: 88%;
    max-width: 1240px;
    margin: 0 auto;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: #fff;
    box-shadow: var(--shadow-sm);
}

.catalog-table {
    width: 100%;
    min-width: 820px;
    border-collapse: collapse;
    color: var(--text);
    font-size: 13px;
}

.catalog-table th,
.catalog-table td {
    padding: 16px 18px;
    border-bottom: 1px solid #eee7f5;
    text-align: left;
    vertical-align: middle;
}

.catalog-table th {
    background: #f5effb;
    color: var(--purple-dark);
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
}

.catalog-table tbody tr:last-child td { border-bottom: 0; }

.catalog-table tbody tr:hover { background: #fcfaff; }

.catalog-table .catalog-number {
    width: 54px;
    color: var(--muted);
}

.catalog-table .catalog-name {
    min-width: 220px;
    color: var(--purple-dark);
    font-weight: 700;
}

.catalog-detail-link {
    display: inline-block;
    padding: 7px 13px;
    border: 1px solid #dfd0f1;
    border-radius: 8px;
    color: var(--purple-dark);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
}

.catalog-detail-link:hover {
    border-color: var(--purple);
    background: var(--purple-pale);
}

.catalog-empty { width: 88%; max-width: 1240px; margin: 0 auto; }

.public-detail-panel {
    width: 92%;
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(24px, 4.5vw, 48px);
    border: 1px solid var(--border);
    border-radius: 16px;
    background: #fff;
    box-shadow: var(--shadow-sm);
}

.public-detail-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 36px;
    margin: 0;
}

.public-detail-list > div {
    padding: 20px 0;
    border-bottom: 1px solid #eee7f5;
}

.public-detail-list dt {
    margin-bottom: 7px;
    color: var(--muted);
    font-size: 14px;
}

.public-detail-list dd {
    margin: 0;
    color: var(--purple-dark);
    font-size: 16px;
    font-weight: 600;
    overflow-wrap: anywhere;
}

.public-detail-list .public-detail-wide { grid-column: 1 / -1; }

.public-detail-person { display: block; margin: 0 0 6px; }

.public-detail-person small {
    margin-left: 6px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 400;
}

/* Participant profile and achievement history on the public detail page. */
.public-profile-section {
    padding-top: clamp(38px, 6vw, 72px);
    padding-bottom: 84px;
}
.public-profile-heading,
.public-achievement-section {
    width: min(92%, 1160px);
    margin-inline: auto;
}
.public-profile-back {
    display: inline-flex;
    margin-bottom: 20px;
    color: var(--purple-dark);
    font-weight: 650;
    text-decoration: none;
}
.public-profile-back:hover { color: var(--purple); }
.public-profile-card {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: clamp(24px, 4vw, 40px);
    border: 1px solid var(--border);
    border-radius: 20px;
    background: #fff;
    box-shadow: var(--shadow-sm);
}
.public-profile-avatar {
    display: grid;
    flex: 0 0 76px;
    width: 76px;
    height: 76px;
    place-items: center;
    border-radius: 50%;
    background: #f3edf9;
    color: var(--purple-dark);
    font-size: 30px;
    font-weight: 750;
}
.public-profile-identity { min-width: 0; flex: 1; }
.public-profile-identity .eyebrow { margin-bottom: 8px; }
.public-profile-identity h1 {
    margin: 0 0 10px;
    color: var(--purple-dark);
    font-size: clamp(25px, 3vw, 34px);
}
.public-profile-meta { display: flex; flex-wrap: wrap; gap: 8px; }
.public-profile-meta span {
    padding: 6px 10px;
    border-radius: 999px;
    background: #f7f4fa;
    color: var(--muted);
    font-size: 13px;
}
.public-profile-count {
    display: grid;
    justify-items: center;
    gap: 2px;
    min-width: 130px;
    padding-left: 24px;
    border-left: 1px solid var(--border);
    color: var(--muted);
    font-size: 13px;
}
.public-profile-count strong { color: var(--purple-dark); font-size: 30px; }
.public-achievement-section { margin-top: clamp(40px, 6vw, 64px); }
.public-achievement-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 20px;
}
.public-achievement-heading .eyebrow { margin-bottom: 6px; }
.public-achievement-heading h2 {
    margin: 0;
    color: var(--purple-dark);
    font-size: clamp(25px, 3vw, 32px);
}
.public-achievement-heading > p { margin: 0 0 4px; color: var(--muted); }
.public-achievement-list { display: grid; gap: 14px; }
.public-achievement-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 300px);
    gap: 24px;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: rgba(255, 255, 255, .94);
    box-shadow: 0 8px 24px rgba(57, 38, 83, .045);
}
.public-achievement-main { display: flex; align-items: start; gap: 20px; }
.public-achievement-year {
    flex: 0 0 58px;
    padding-top: 4px;
    color: var(--muted);
    font-weight: 650;
}
.public-achievement-copy h3 { margin: 0 0 9px; color: var(--purple-dark); font-size: 19px; }
.public-achievement-tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 8px; }
.public-achievement-tags span {
    padding: 5px 9px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    font-size: 12px;
}
.public-achievement-organizer,
.public-achievement-description,
.public-achievement-team { margin: 7px 0 0; color: var(--muted); line-height: 1.6; }
.public-achievement-team strong { color: var(--purple-dark); }
.public-achievement-evidence { min-width: 0; }
.public-evidence-label { display: block; margin-bottom: 9px; color: var(--muted); font-size: 12px; font-weight: 650; }
.public-evidence-files { display: flex; flex-wrap: wrap; gap: 10px; }
.public-evidence-image {
    display: grid;
    width: 112px;
    gap: 5px;
    color: var(--purple-dark);
    font-size: 11px;
    text-decoration: none;
}
.public-evidence-image img {
    width: 112px;
    height: 78px;
    border: 1px solid var(--border);
    border-radius: 9px;
    object-fit: cover;
}
.public-evidence-image span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.public-evidence-document {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 9px 12px;
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--purple-dark);
    font-size: 12px;
    text-decoration: none;
}
.public-evidence-document span { color: #ad4b56; font-size: 11px; font-weight: 750; }
.public-evidence-image:hover,
.public-evidence-document:hover { color: var(--purple); }
.public-profile-section .section-heading.catalog-back { margin-top: 42px; }


.recent-grid-compact .recent-card {
    padding: 20px;
    border-radius: 16px;
}

.recent-grid-compact .prestasi-photo {
    height: 180px;
    margin: -20px -20px 16px;
}

.section-heading.recent-cta {
    margin: 42px auto 0;
}

/* Keep the return link comfortably separated from the cards and footer. */
.section-heading.catalog-back {
    margin: 68px auto 0;
    padding: 0;
}

.section.catalog-section {
    padding-bottom: clamp(150px, 20vh, 240px);
}

.recent-card {
    position: relative;
    min-width: 0;
    overflow: hidden;
    padding: 25px;
    border: 1px solid #e2d5f2;
    border-radius: 20px;
    background: linear-gradient(145deg, #ffffff 48%, #f5efff 100%);
    box-shadow: var(--shadow-sm);
    transition: transform .2s ease, box-shadow .2s ease;
}

.recent-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: linear-gradient(180deg, var(--gold), var(--purple-mid) 52%, var(--purple-dark));
}

.recent-card:hover {
    transform: translateY(-3px);
    border-color: #c6adeb;
    box-shadow: var(--shadow-md);
}

.prestasi-photo {
    height: 210px;
    margin: -25px -25px 20px;
    overflow: hidden;
    background: linear-gradient(135deg, #eee5f7, #f8f3fc 58%, #f7f0dd);
}

.prestasi-photo a,
.prestasi-photo img {
    display: block;
    width: 100%;
    height: 100%;
}

.prestasi-photo img {
    object-fit: cover;
    transition: transform .25s ease;
}

.recent-card:hover .prestasi-photo img {
    transform: scale(1.035);
}

.prestasi-photo-placeholder {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 8px;
    color: var(--purple);
}

.prestasi-photo-placeholder span {
    font-size: 38px;
}

.prestasi-photo-placeholder small {
    color: var(--muted);
    font-size: 11px;
}

.recent-card h3 {
    margin: 0 0 14px;
    color: var(--purple-dark);
    font-size: 17px;
    line-height: 1.5;
}

.recent-card p {
    margin: 0 0 7px;
    color: #655774;
    font-size: 13px;
    overflow-wrap: anywhere;
}

.recent-card small {
    color: var(--muted);
    font-size: 12px;
}

.recent-organizer {
    margin-top: 12px !important;
    color: var(--muted) !important;
    font-size: 12px !important;
}

/* ==================================================
   EMPTY STATE
================================================== */

.empty-state {
    grid-column: 1 / -1;
    width: 100%;
    padding: 32px 24px;
    border: 1px dashed #cbb4ee;
    border-radius: var(--radius);
    background: linear-gradient(125deg, #f8f4ff, #eee5fb 65%, #f8f0df);
    color: var(--purple-dark);
    text-align: center;
}

.empty-state p {
    max-width: 660px;
    margin: 0 auto 18px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.8;
}

/* ==================================================
   FOOTER
================================================== */

.site-footer {
    position: relative;
    overflow: hidden;
    padding: 58px 0 0;
    border-top: 1px solid rgba(255, 255, 255, .1);
    background: radial-gradient(ellipse at 12% 0%, rgba(161, 123, 232, .2), transparent 34%), linear-gradient(125deg, #302044 0%, #392653 56%, #493264 100%);
    color: rgba(255, 255, 255, .78);
}
.site-footer::before { content: ""; position: absolute; top: 0; left: 6%; width: 96px; height: 3px; border-radius: 0 0 4px 4px; background: linear-gradient(90deg, #e7cb88, var(--gold)); }
.footer-inner { width: min(1200px, 88%); margin: 0 auto; display: grid; grid-template-columns: minmax(240px, 1.5fr) repeat(2, minmax(170px, 1fr)); gap: clamp(32px, 6vw, 88px); padding-bottom: 42px; }
.footer-brand { display: inline-block; color: #fff; font-size: 27px; font-weight: 800; letter-spacing: -1px; text-decoration: none; }
.footer-brand span { color: #e3c274; }
.footer-brand-block p { max-width: 330px; margin: 13px 0 16px; color: rgba(255,255,255,.7); font-size: 13px; line-height: 1.8; }
.footer-campus { display: inline-flex; align-items: center; gap: 8px; color: #e9d7a7; font-size: 12px; font-weight: 600; }
.footer-campus::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 4px rgba(201,164,94,.14); }
.footer-links-group { display: flex; flex-direction: column; align-items: flex-start; gap: 11px; }
.footer-links-group h2 { margin: 4px 0 6px; color: #fff; font-size: 12px; font-weight: 800; letter-spacing: 1.3px; text-transform: uppercase; }
.footer-links-group a { color: rgba(255,255,255,.7); font-size: 13px; line-height: 1.45; text-decoration: none; transition: color .18s ease, transform .18s ease; }
.footer-links-group a:hover { color: #f1d791; transform: translateX(3px); }
.footer-bottom { width: min(1200px, 88%); min-height: 62px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 16px; border-top: 1px solid rgba(255,255,255,.14); color: rgba(255,255,255,.56); font-size: 11px; }
.footer-bottom-note { color: rgba(255,255,255,.68); }
@media (max-width: 760px) {
    .site-footer { padding-top: 42px; }
    .footer-inner { width: 90%; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 32px 24px; padding-bottom: 32px; }
    .footer-brand-block { grid-column: 1 / -1; }
    .footer-bottom { width: 90%; align-items: flex-start; flex-direction: column; justify-content: center; gap: 5px; padding: 14px 0; }
}

/* Compact, balanced layout for public achievement details. */
.achievement-detail-section {
    padding-block: 34px 56px;
}
.achievement-detail-shell {
    width: min(92%, 1240px);
}
.achievement-detail-section .public-profile-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 14px;
    font-size: 14px;
}
.achievement-detail-card {
    border-color: #e8e1ed;
    border-radius: 20px;
    box-shadow: 0 12px 34px rgba(48, 31, 68, .06);
}
.achievement-detail-section .achievement-detail-header {
    padding: 25px 32px 22px;
    background: linear-gradient(110deg, #fff 0%, #fcfaff 72%, #f8f4fc 100%);
}
.achievement-detail-header h1 {
    font-size: clamp(30px, 3vw, 40px);
    line-height: 1.12;
}
.achievement-detail-section .achievement-detail-header p {
    margin-top: 8px;
    max-width: 760px;
}
.achievement-detail-section .achievement-detail-layout {
    grid-template-columns: minmax(0, 1.35fr) minmax(320px, .8fr);
}
.achievement-detail-main {
    padding: 8px 30px 18px;
}
.achievement-detail-main .achievement-detail-block {
    padding-block: 20px;
}
.achievement-detail-block-heading {
    align-items: center;
    margin-bottom: 12px;
}
.achievement-detail-section .achievement-detail-facts {
    gap: 9px 12px;
}
.achievement-detail-section .achievement-detail-facts > div {
    min-height: 66px;
    padding: 11px 13px;
    border: 1px solid #eee9f2;
    border-radius: 11px;
    background: #fcfbfd;
}
.achievement-detail-section .achievement-detail-facts > div:nth-last-child(-n+2) {
    border-bottom: 1px solid #eee9f2;
}
.achievement-detail-section .achievement-detail-fact-wide {
    grid-column: 1 / -1;
}
.achievement-participant-list {
    gap: 9px;
}
.achievement-participant {
    border-color: #eee9f2;
    border-radius: 12px;
    background: #fcfbfd;
}
.achievement-description-block > p {
    margin: 0;
    padding: 13px 15px;
    border-radius: 11px;
    background: #fcfbfd;
    color: var(--text);
}
.achievement-detail-section .achievement-evidence-panel {
    padding: 26px 24px;
    border-left-color: #eee9f2;
    background: #fbf9fd;
}
.achievement-evidence-heading {
    margin-bottom: 16px;
}
.achievement-evidence-grid {
    grid-template-columns: 1fr;
    gap: 12px;
}
.achievement-detail-section .achievement-evidence-image {
    display: block;
    overflow: hidden;
    padding: 8px;
    border: 1px solid #eae4ef;
    border-radius: 13px;
    background: #fff;
}
.achievement-detail-section .achievement-evidence-image img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: none;
    object-fit: cover;
    object-position: center 38%;
    border: 0;
    border-radius: 8px;
    background: #f5f2f7;
}
.achievement-detail-section .achievement-evidence-image span {
    display: block;
    padding: 9px 3px 1px;
    color: #665776;
    font-size: 12px;
    overflow-wrap: anywhere;
}
.achievement-detail-section .achievement-evidence-file {
    border-color: #eae4ef;
    border-radius: 13px;
    background: #fff;
}
@media (max-width: 900px) {
    .achievement-detail-section .achievement-detail-layout {
        grid-template-columns: minmax(0, 1fr) minmax(270px, .8fr);
    }
    .achievement-detail-main { padding-inline: 22px; }
    .achievement-detail-section .achievement-evidence-panel { padding-inline: 18px; }
}
@media (max-width: 760px) {
    .achievement-detail-section { padding-block: 24px 40px; }
    .achievement-detail-shell { width: min(94%, 600px); }
    .achievement-detail-section .achievement-detail-header { padding: 20px 20px 17px; }
    .achievement-detail-section .achievement-detail-layout { grid-template-columns: 1fr; }
    .achievement-detail-main { padding: 0 18px 8px; }
    .achievement-detail-section .achievement-detail-facts { grid-template-columns: 1fr 1fr; gap: 8px; }
    .achievement-detail-section .achievement-detail-facts > div { min-height: 60px; padding: 10px 11px; }
    .achievement-detail-section .achievement-evidence-panel {
        padding: 20px 18px;
        border-top: 1px solid #eee9f2;
        border-left: 0;
    }
}
@media (max-width: 420px) {
    .achievement-detail-section .achievement-detail-facts { grid-template-columns: 1fr; }
    .achievement-detail-section .achievement-detail-fact-wide { grid-column: auto; }
}


/* Keep the public competition pages visually separated from the footer. */
.group-page-section { padding-bottom: clamp(76px, 8vw, 104px); }
.group-results-section { padding-bottom: clamp(64px, 7vw, 88px); }
@media (max-width: 760px) {
    .group-page-section { padding-bottom: 64px; }
    .group-results-section { padding-bottom: 56px; }
}

/* Small visual cues for achievement metadata on public profiles. */
.profile-achievement-copy .public-achievement-tags .achievement-tag {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 8px;
    color: #665776;
    line-height: 1.2;
}
.profile-achievement-copy .achievement-tag svg {
    width: 12px;
    height: 12px;
    flex: 0 0 12px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.35;
}
.profile-achievement-copy .achievement-tag-rank svg {
    color: #a87920;
}
@media (max-width: 480px) {
    .footer-inner { grid-template-columns: 1fr; gap: 27px; }
    .footer-brand-block { grid-column: auto; }
    .footer-links-group { gap: 9px; }
    .footer-bottom { font-size: 10px; }
}
/* ==================================================
   RESPONSIVE TABLET
================================================== */

@media (max-width: 1100px) {
    .nav-wrap { gap: 18px; }
    .main-nav { gap: 13px; }
    .main-nav a { gap: 6px; font-size: 11px; }
    .brand { font-size: 24px; }

    .competition-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stats-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .people-grid,
    .recent-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hero-slider { height: 540px; }
}

/* ==================================================
   RESPONSIVE MOBILE
================================================== */

@media (max-width: 760px) {
    .nav-wrap {
        position: relative;
        min-height: 68px;
        justify-content: space-between;
    }

    .brand { font-size: 25px; }

    .nav-toggle { display: block; }

    .main-nav {
        position: absolute;
        top: 100%;
        right: 0;
        left: 0;
        z-index: 1001;
        display: none;
        align-items: stretch;
        flex-direction: column;
        gap: 0;
        margin-left: 0;
        padding: 8px 18px 15px;
        border: 1px solid var(--border);
        border-bottom: 2px solid var(--gold);
        background: #ffffff;
        box-shadow: var(--shadow-md);
    }

    .main-nav.show { display: flex; }

    .main-nav a {
        padding: 13px 7px;
        font-size: 14px;
        white-space: normal;
    }

    .main-nav a svg {
        width: 18px;
        height: 18px;
    }

    .main-nav a.active::after { display: none; }

    .hero-slider {
        height: 500px;
        min-height: 0;
    }

    .slide-overlay {
        background: linear-gradient(
            100deg,
            rgba(48, 29, 77, .87),
            rgba(87, 53, 139, .67)
        );
    }

    .slide-content { width: 82%; }

    .slide-content h1 {
        font-size: clamp(30px, 7vw, 43px);
        letter-spacing: -.6px;
    }

    .slide-content p { font-size: 14px; }

    .slider-btn {
        width: 36px;
        height: 36px;
        font-size: 23px;
    }

    .slider-btn.prev { left: 10px; }
    .slider-btn.next { right: 10px; }

    .hero-slider {
        width: calc(100% - 24px);
        min-height: 0;
        margin-top: 12px;
        border-radius: 20px;
    }

    .section { padding: 62px 0; }

    .section-heading,
    .stats-grid,
    .competition-grid,
    .chart-card,
    .people-grid,
    .recent-grid,
    .split-heading {
        width: 90%;
    }

    .chart-card { padding: 18px; }
    .chart-legend { gap: 12px; }
    .chart-legend span { font-size: 10px; }
    .bar-groups { gap: 5px; }
    .bars { gap: 2px; }

    .hero-actions { align-items: stretch; }
    .hero-actions .btn { min-width: 150px; }

    .footer-inner {
        width: 90%;
        align-items: flex-start;
        flex-direction: column;
    }
}

/* ==================================================
   SMALL MOBILE
================================================== */

@media (max-width: 480px) {
    .hero-slider { height: 460px; }
    .slide-content { width: 80%; }
    .slide-content h1 { font-size: 30px; }

    .competition-grid,
    .people-grid,
    .recent-grid {
        grid-template-columns: 1fr;
    }

    .stats-grid { gap: 12px; }
    .stat-box { padding: 20px 10px; }
    .stat-value { font-size: 27px; }
    .stat-label { font-size: 12px; }
    .competition-image { height: 190px; }

    .chart-card { padding: 13px; }
    .chart-legend { gap: 10px 13px; }
    .chart-area { height: 240px; }

    .bar-chart {
        grid-template-columns: 28px minmax(0, 1fr);
        gap: 8px;
    }

    .split-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .person-card { padding: 20px; }
}

@media (max-width: 640px) {
    .catalog-table-wrap,
    .catalog-empty { width: 90%; }

    .catalog-table th,
    .catalog-table td { padding: 13px 14px; }

    .public-detail-panel { width: 90%; }
    .public-detail-list { grid-template-columns: 1fr; }
    .public-detail-list .public-detail-wide { grid-column: auto; }
}

/* ==================================================
   ACCESSIBILITY
================================================== */

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
        animation-duration: .01ms !important;
    }
}


/* ==================================================
   DROPDOWN NAVBAR — TAMBAHAN
   Mempertahankan desain ungu dan emas SIPRESKA
================================================== */

.main-nav .nav-dropdown {
    position: relative;
    display: flex;
    align-items: center;
}

.main-nav .nav-dropdown-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 25px 0 22px;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: #57466c;
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.6;
    cursor: pointer;
    white-space: nowrap;
    transition: color .2s ease;
}

.main-nav .nav-dropdown-toggle svg {
    width: 17px;
    height: 17px;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.main-nav .nav-dropdown-toggle:hover,
.main-nav .nav-dropdown-toggle.active,
.main-nav .nav-dropdown.open .nav-dropdown-toggle {
    color: var(--gold-dark);
}

.main-nav .nav-dropdown-toggle.active::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 3px;
    border-radius: 3px 3px 0 0;
    background: linear-gradient(90deg, var(--gold), #e4c87f);
}

.ranking-grid {
    width: 88%;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
}

.ranking-panel {
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: #fff;
    box-shadow: var(--shadow-sm);
}

.ranking-panel h3 {
    margin: 0 0 16px;
    color: var(--purple-dark);
    font-size: 18px;
}

.ranking-search {
    width: 88%;
    max-width: 1200px;
    margin: 0 auto 24px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: #fff;
    box-shadow: var(--shadow-sm);
}

.ranking-search .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}

.ranking-search input {
    min-width: 0;
    flex: 1;
    height: 44px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: 9px;
    outline: none;
    color: var(--text);
}

.ranking-search input:focus {
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(201, 164, 94, .14);
}

.ranking-search button,
.ranking-search-reset {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    border: 1px solid var(--gold);
    border-radius: 9px;
    background: var(--gold-light);
    color: var(--gold-dark);
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
}

.ranking-search-reset {
    border-color: var(--border);
    background: #fff;
    color: var(--muted);
}

.ranking-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
}

.ranking-list li:not(.ranking-empty) {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 56px;
    padding: 9px 12px;
    border: 1px solid #eee7f5;
    border-radius: 11px;
    background: #fdfbff;
}

.ranking-position {
    display: grid;
    width: 30px;
    height: 30px;
    flex: 0 0 30px;
    place-items: center;
    border-radius: 50%;
    background: var(--gold-light);
    color: var(--gold-dark);
    font-size: 13px;
    font-weight: 700;
}

.ranking-name {
    min-width: 0;
    flex: 1;
    color: var(--text);
    font-size: 13px;
    font-weight: 600;
    overflow-wrap: anywhere;
}

.ranking-name small {
    display: block;
    margin-top: 2px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 400;
}

.ranking-total {
    flex: 0 0 auto;
    color: var(--gold-dark);
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
}

.ranking-empty {
    padding: 18px;
    color: var(--muted);
    text-align: center;
}

@media (max-width: 760px) {
    .ranking-search {
        width: 90%;
        flex-wrap: wrap;
    }

    .ranking-search input {
        flex-basis: 100%;
    }

    .ranking-grid {
        width: 90%;
        grid-template-columns: 1fr;
        gap: 16px;
    }

    .ranking-panel { padding: 18px; }
}

.dropdown-chevron {
    display: inline-block;
    color: currentColor;
    font-size: 17px;
    line-height: 1;
    transition: transform .2s ease;
}

.nav-dropdown.open .dropdown-chevron {
    transform: rotate(180deg);
}

/* Kotak dropdown */
.nav-dropdown-menu {
    position: absolute;
    top: calc(100% + 2px);
    left: -12px;
    z-index: 1100;
    display: none;
    min-width: 220px;
    max-width: min(280px, 85vw);
    padding: 8px;
    border: 1px solid var(--border);
    border-top: 1px solid var(--border);
    border-radius: 0 0 12px 12px;
    background: #ffffff;
    box-shadow: var(--shadow-md);
}

/* Tampilkan saat dropdown dibuka */
.nav-dropdown.open .nav-dropdown-menu {
    display: flex;
    flex-direction: column;
}

/* Tautan di dalam dropdown */
.main-nav .nav-dropdown-menu a {
    position: static;
    display: block;
    width: 100%;
    padding: 11px 13px;
    border-radius: 7px;
    color: var(--text);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.5;
    text-decoration: none;
    white-space: normal;
}

.main-nav .nav-dropdown-menu a::after {
    display: none;
}

.main-nav .nav-dropdown-menu a:hover {
    background: var(--purple-pale);
    color: var(--purple-dark);
}

.dropdown-empty {
    display: block;
    padding: 11px 13px;
    color: var(--muted);
    font-size: 12px;
}

/* Dropdown di HP */
@media (max-width: 1100px) and (min-width: 761px) {
    .main-nav .nav-dropdown-toggle {
        gap: 6px;
        font-size: 11px;
    }

    .main-nav .nav-dropdown-toggle svg {
        width: 16px;
        height: 16px;
    }
}

@media (max-width: 760px) {
    .main-nav .nav-dropdown {
        display: block;
        width: 100%;
    }

    .main-nav .nav-dropdown-toggle {
        display: flex;
        width: 100%;
        justify-content: flex-start;
        padding: 13px 7px;
        border-radius: 8px;
        font-size: 14px;
        text-align: left;
        white-space: normal;
    }

    .main-nav .nav-dropdown-toggle svg {
        width: 18px;
        height: 18px;
    }

    .main-nav .nav-dropdown-toggle.active::after {
        display: none;
    }

    .main-nav .nav-dropdown-toggle .dropdown-chevron {
        margin-left: auto;
    }

    .nav-dropdown-menu {
        position: static;
        width: calc(100% - 20px);
        max-width: none;
        min-width: 0;
        margin: 0 0 8px 20px;
        padding: 5px;
        border: 0;
        border-left: 2px solid var(--gold);
        border-radius: 0;
        background: #ffffff;
        box-shadow: none;
    }

    .main-nav .nav-dropdown-menu a {
        padding: 10px 12px;
        font-size: 13px;
    }
}

@media (max-width: 760px) {
    .public-profile-heading,
    .public-achievement-section { width: 92%; }
    .public-profile-card { align-items: flex-start; flex-wrap: wrap; gap: 16px; }
    .public-profile-avatar { flex-basis: 58px; width: 58px; height: 58px; font-size: 24px; }
    .public-profile-identity { flex-basis: calc(100% - 74px); }
    .public-profile-count {
        display: flex;
        align-items: baseline;
        gap: 8px;
        width: 100%;
        padding: 12px 0 0;
        border-top: 1px solid var(--border);
        border-left: 0;
    }
    .public-profile-count strong { font-size: 22px; }
    .public-achievement-heading { align-items: flex-start; flex-direction: column; gap: 8px; }
    .public-achievement-item { grid-template-columns: 1fr; gap: 16px; }
}

/* Professional finish for the public landing page */
.hero-slider {
    border-color: rgba(255, 255, 255, .32);
    box-shadow: 0 28px 76px rgba(43, 28, 63, .24);
}

.slide-content .eyebrow {
    color: #f0d79c;
    letter-spacing: 2px;
}

.slide-content h1 {
    max-width: 800px;
    text-wrap: balance;
    text-shadow: 0 3px 22px rgba(24, 16, 37, .22);
}

.slide-content p {
    max-width: 650px;
    text-shadow: 0 2px 12px rgba(24, 16, 37, .18);
}

.stat-box,
.competition-card,
.recent-card,
.chart-card {
    box-shadow: 0 12px 32px rgba(57, 38, 83, .07);
}

.stat-box {
    border-radius: 18px;
    transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease;
}

.stat-box:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 38px rgba(57, 38, 83, .12);
}

.competition-card,
.recent-card {
    border-radius: 22px;
    transition: transform .24s ease, border-color .24s ease, box-shadow .24s ease;
}

.competition-card:hover,
.recent-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 42px rgba(57, 38, 83, .13);
}

.chart-card {
    border-radius: 22px;
    box-shadow: 0 16px 42px rgba(57, 38, 83, .08);
}

.bar.nasional {
    background: linear-gradient(180deg, #b999e9 0%, #7047a9 100%);
    box-shadow: 0 8px 18px rgba(112, 71, 169, .2);
}

@media (prefers-reduced-motion: reduce) {
    .stat-box,
    .competition-card,
    .recent-card,
    .hero-slider .slide > img {
        transition: none;
    }
}
/* Keep the footer grid intact after legacy responsive rules. */
.footer-inner { display: grid; align-items: initial; flex-direction: initial; }
@media (max-width: 760px) {
    .footer-inner { width: 90%; grid-template-columns: repeat(2, minmax(0,1fr)); align-items: initial; flex-direction: initial; }
    .footer-brand-block { grid-column: 1 / -1; }
}
@media (max-width: 480px) {
    .footer-inner { grid-template-columns: 1fr; }
    .footer-brand-block { grid-column: auto; }
}
/* Achievement cards link to their own public detail pages. */
.recent-card-link {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
}

.recent-card-link:focus-visible {
    outline: 3px solid rgba(201, 164, 94, .72);
    outline-offset: 4px;
}

.recent-card-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 18px;
    padding-top: 13px;
    border-top: 1px solid rgba(87, 53, 139, .12);
    color: var(--purple-dark);
    font-size: 12px;
    font-weight: 750;
    letter-spacing: .15px;
}

.recent-card-action span {
    display: inline-flex;
    width: 27px;
    height: 27px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(201, 164, 94, .48);
    border-radius: 50%;
    background: var(--gold-pale);
    color: var(--gold-dark);
    font-size: 16px;
    transition: transform .2s ease, background .2s ease, color .2s ease;
}

.recent-card-link:hover .recent-card-action span {
    transform: translateX(3px);
    background: var(--gold);
    color: #fff;
}

@media (prefers-reduced-motion: reduce) {
    .recent-card-action span { transition: none; }
}
/* Participant directory: one card per sivitas, with profile-level navigation. */
.participant-directory {
    width: min(92%, 1160px);
    margin-inline: auto;
    display: grid;
    gap: 14px;
}
.participant-card {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr) auto;
    align-items: center;
    gap: 18px;
    padding: 20px 24px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: rgba(255,255,255,.96);
    box-shadow: 0 8px 24px rgba(57,38,83,.045);
    transition: transform .18s ease, box-shadow .18s ease;
}
.participant-card:hover { transform: translateY(-2px); box-shadow: 0 14px 30px rgba(57,38,83,.09); }
.participant-card-avatar, .achievement-participant-avatar {
    display: grid; width: 54px; height: 54px; place-items: center; border-radius: 50%;
    background: linear-gradient(145deg, #f3edf9, #fff7e5); color: var(--purple-dark); font-weight: 750; font-size: 21px;
}
.participant-card-role { color: var(--muted); font-size: 11px; font-weight: 750; letter-spacing: .09em; text-transform: uppercase; }
.participant-card-main h2 { margin: 3px 0 5px; color: var(--purple-dark); font-size: 19px; }
.participant-card-meta { display: flex; flex-wrap: wrap; gap: 7px; margin: 0; color: var(--muted); font-size: 13px; }
.participant-card-meta span + span::before { content: '·'; margin-right: 7px; color: #c8b8da; }
.participant-card-side { display: grid; grid-template-columns: auto auto; align-items: baseline; justify-content: end; gap: 2px 6px; color: var(--muted); font-size: 12px; }
.participant-card-side strong { color: var(--purple-dark); font-size: 21px; }
.participant-card-side .catalog-detail-link { grid-column: 1 / -1; justify-self: end; margin-top: 7px; }
.public-profile-achievements { gap: 12px; }
.profile-achievement-row {
    display: grid; grid-template-columns: 68px minmax(0,1fr) auto; align-items: center; gap: 18px;
    padding: 20px 22px; border: 1px solid var(--border); border-radius: 15px;
    background: rgba(255,255,255,.96); box-shadow: 0 7px 20px rgba(57,38,83,.04);
}
.profile-achievement-year { color: var(--muted); font-size: 14px; font-weight: 750; }
.profile-achievement-copy h3 { margin: 0 0 8px; color: var(--purple-dark); font-size: 18px; }
.profile-achievement-copy .public-achievement-tags { margin-bottom: 0; }
.profile-achievement-action { display: inline-flex; align-items: center; gap: 10px; padding: 10px 14px; border: 1px solid var(--border); border-radius: 9px; color: var(--purple-dark); font-size: 13px; font-weight: 750; text-decoration: none; white-space: nowrap; }
.profile-achievement-action:hover { border-color: var(--purple); background: var(--purple-pale); }
.achievement-detail-shell { width: min(92%, 1160px); margin-inline: auto; }
.achievement-detail-header { display: flex; align-items: end; justify-content: space-between; gap: 24px; padding: 12px 0 28px; }
.achievement-detail-header .eyebrow { margin-bottom: 8px; }
.achievement-detail-header h1 { margin: 0; color: var(--purple-dark); font-size: clamp(30px,4vw,44px); letter-spacing: -.025em; }
.achievement-detail-header p { margin: 9px 0 0; color: var(--muted); }
.achievement-detail-year { display: grid; gap: 4px; min-width: 130px; padding: 14px 18px; border: 1px solid var(--border); border-radius: 13px; background: #fff; color: var(--muted); font-size: 12px; }
.achievement-detail-year strong { color: var(--purple-dark); font-size: 22px; }
.achievement-detail-layout { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(270px, .75fr); align-items: start; gap: 18px; }
.achievement-detail-main { display: grid; gap: 16px; }
.achievement-detail-block, .achievement-evidence-panel { padding: clamp(20px,3vw,28px); border: 1px solid var(--border); border-radius: 17px; background: rgba(255,255,255,.97); box-shadow: var(--shadow-sm); }
.achievement-detail-block-heading { display: flex; align-items: center; gap: 13px; margin-bottom: 20px; }
.achievement-detail-block-heading > span { display: grid; flex: 0 0 38px; width: 38px; height: 38px; place-items: center; border: 1px solid var(--border); border-radius: 11px; background: #f8f3fc; color: var(--purple-dark); font-size: 12px; font-weight: 800; }
.achievement-detail-block-heading h2, .achievement-evidence-heading h2 { margin: 0; color: var(--purple-dark); font-size: 19px; }
.achievement-detail-block-heading p, .achievement-evidence-heading p { margin: 4px 0 0; color: var(--muted); font-size: 13px; line-height: 1.55; }
.achievement-detail-facts { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 0 22px; margin: 0; }
.achievement-detail-facts > div { padding: 14px 0; border-top: 1px solid #eee7f5; }
.achievement-detail-facts dt { margin-bottom: 6px; color: var(--muted); font-size: 12px; }
.achievement-detail-facts dd { margin: 0; color: var(--text); font-size: 14px; font-weight: 700; overflow-wrap: anywhere; }
.achievement-detail-fact-wide { grid-column: 1/-1; }
.achievement-participant-list { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 9px; }
.achievement-participant { display: flex; align-items: center; gap: 11px; padding: 11px; border: 1px solid #eee7f5; border-radius: 12px; background: #fdfbff; }
.achievement-participant-avatar { flex: 0 0 38px; width: 38px; height: 38px; font-size: 15px; }
.achievement-participant div { display: grid; gap: 3px; min-width: 0; }
.achievement-participant strong { color: var(--purple-dark); font-size: 13px; }
.achievement-participant div span { color: var(--muted); font-size: 11px; }
.achievement-description-block > p { margin: 0; color: var(--text); line-height: 1.75; white-space: pre-line; }
.achievement-evidence-heading { margin-bottom: 19px; }
.achievement-evidence-heading .eyebrow { display: block; margin-bottom: 7px; }
.achievement-evidence-grid { display: grid; gap: 11px; }
.achievement-evidence-image { display: grid; gap: 7px; color: var(--purple-dark); font-size: 12px; text-decoration: none; }
.achievement-evidence-image img { width: 100%; max-height: 230px; aspect-ratio: 4/3; border: 1px solid var(--border); border-radius: 11px; object-fit: cover; background: #f7f4fa; }
.achievement-evidence-image span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.achievement-evidence-file { display: grid; grid-template-columns: 44px minmax(0,1fr) auto; align-items: center; gap: 10px; padding: 12px; border: 1px solid var(--border); border-radius: 12px; color: var(--purple-dark); text-decoration: none; }
.achievement-file-icon { display: grid; width: 40px; height: 44px; place-items: center; border-radius: 8px; background: #f9eeee; color: #aa4753; font-size: 10px; font-weight: 800; }
.achievement-evidence-file > span:nth-child(2) { display: grid; gap: 4px; min-width: 0; }
.achievement-evidence-file strong { overflow: hidden; font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }
.achievement-evidence-file small { color: var(--muted); font-size: 11px; }
.achievement-evidence-empty { display: grid; min-height: 155px; place-content: center; justify-items: center; padding: 18px; border: 1px dashed #d8c9e9; border-radius: 13px; color: var(--muted); text-align: center; }
.achievement-evidence-empty > span { display: grid; width: 36px; height: 36px; place-items: center; border-radius: 50%; background: #f6f0fb; color: var(--purple-dark); font-size: 22px; }
.achievement-evidence-empty p, .achievement-detail-empty { margin: 10px 0 0; color: var(--muted); font-size: 13px; }
@media (max-width: 760px) {
    .participant-card { grid-template-columns: 48px minmax(0,1fr); padding: 16px; gap: 13px; }
    .participant-card-avatar { width: 46px; height: 46px; }
    .participant-card-side { grid-column: 2; justify-content: start; grid-template-columns: auto auto auto; }
    .participant-card-side .catalog-detail-link { grid-column: 3; grid-row: 1; margin: 0 0 0 8px; }
    .profile-achievement-row { grid-template-columns: 48px minmax(0,1fr); gap: 10px 14px; padding: 16px; }
    .profile-achievement-action { grid-column: 2; justify-self: start; }
    .achievement-detail-header { align-items: start; flex-direction: column; }
    .achievement-detail-layout { grid-template-columns: 1fr; }
    .achievement-detail-facts, .achievement-participant-list { grid-template-columns: 1fr; }
}
/* Refined directory and profile history: use editorial rows instead of nested cards. */
.participant-directory {
    display: block;
    overflow: hidden;
    padding: 8px 28px;
    border: 1px solid #e8def2;
    border-radius: 20px;
    background: rgba(255,255,255,.96);
    box-shadow: 0 18px 46px rgba(48,31,68,.07);
}
.participant-card {
    position: relative;
    grid-template-columns: 56px minmax(0,1fr) minmax(160px,auto);
    gap: 20px;
    padding: 22px 8px;
    border: 0;
    border-bottom: 1px solid #eee8f3;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    transition: background .16s ease;
}
.participant-card:last-child { border-bottom: 0; }
.participant-card:hover { transform: none; background: #fcfaff; box-shadow: none; }
.participant-card-avatar {
    width: 52px;
    height: 52px;
    border: 1px solid #e6d8ef;
    border-radius: 15px;
    background: linear-gradient(145deg,#f7f1fb,#fffaf0);
    font-size: 20px;
}
.participant-card-role { color: #967eaa; font-size: 10px; letter-spacing: .13em; }
.participant-card-main h2 { margin: 5px 0 7px; font-size: 18px; letter-spacing: -.01em; }
.participant-card-meta { min-height: 19px; font-size: 12px; }
.participant-card-side {
    min-width: 175px;
    grid-template-columns: 26px auto auto;
    justify-content: end;
    align-items: center;
    gap: 0 6px;
    padding-left: 18px;
    border-left: 1px solid #eee8f3;
}
.participant-card-side strong { font-size: 19px; }
.participant-card-side .catalog-detail-link {
    grid-column: 3;
    grid-row: 1;
    margin: 0 0 0 12px;
    padding: 9px 12px;
    border-color: transparent;
    background: #f7f2fa;
    font-size: 12px;
}
.participant-card-side .catalog-detail-link:hover { border-color: #ddc8ef; background: #f2eafa; }
.public-profile-card {
    position: relative;
    overflow: hidden;
    border-color: #e8def2;
    box-shadow: 0 18px 46px rgba(48,31,68,.07);
}
.public-profile-card::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 4px; background: linear-gradient(180deg,#c59a37,#7651a5); }
.public-profile-avatar { border: 1px solid #e6d8ef; border-radius: 18px; background: linear-gradient(145deg,#f7f1fb,#fffaf0); }
.public-profile-count { min-width: 148px; }
.public-profile-count strong { font-size: 34px; }
.public-profile-achievements {
    overflow: hidden;
    gap: 0;
    padding: 4px 26px;
    border: 1px solid #e8def2;
    border-radius: 20px;
    background: rgba(255,255,255,.96);
    box-shadow: 0 18px 46px rgba(48,31,68,.07);
}
.profile-achievement-row {
    position: relative;
    grid-template-columns: 64px minmax(0,1fr) 130px;
    gap: 18px;
    padding: 23px 4px;
    border: 0;
    border-bottom: 1px solid #eee8f3;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
}
.profile-achievement-row:last-child { border-bottom: 0; }
.profile-achievement-year { align-self: start; padding-top: 3px; color: #9a83ad; font-size: 13px; }
.profile-achievement-copy h3 { font-size: 17px; }
.profile-achievement-copy .public-achievement-tags span { padding: 4px 9px; background: #fbf9fd; }
.profile-achievement-copy .public-achievement-organizer { font-size: 12px; }
.profile-achievement-action {
    justify-self: end;
    justify-content: center;
    min-width: 120px;
    border-color: #e7dcf0;
    background: transparent;
    font-size: 12px;
}
.profile-achievement-action:hover { background: #f8f3fc; }
.achievement-detail-block, .achievement-evidence-panel { box-shadow: 0 12px 34px rgba(48,31,68,.055); }
@media (max-width: 760px) {
    .participant-directory { padding: 4px 15px; border-radius: 16px; }
    .participant-card { grid-template-columns: 46px minmax(0,1fr); gap: 11px 13px; padding: 17px 2px; }
    .participant-card-avatar { width: 44px; height: 44px; border-radius: 13px; }
    .participant-card-side { grid-column: 2; grid-template-columns: 22px auto auto; justify-content: start; min-width: 0; padding: 0; border: 0; }
    .participant-card-side .catalog-detail-link { grid-column: 3; grid-row: 1; margin-left: 10px; }
    .public-profile-count { justify-items: start; min-width: 0; padding: 0; border: 0; }
    .public-profile-count strong { font-size: 22px; }
    .public-profile-achievements { padding: 3px 16px; border-radius: 16px; }
    .profile-achievement-row { grid-template-columns: 42px minmax(0,1fr); gap: 8px 12px; padding: 18px 2px; }
    .profile-achievement-action { grid-column: 2; justify-self: start; }
}

/* Public sivitas profile: compact identity header and one cohesive history panel. */
.public-profile-section { padding-top: 28px; padding-bottom: 48px; }
.public-profile-back { margin-bottom: 10px; font-size: 14px; }
.public-profile-card {
    min-height: 0;
    gap: 18px;
    padding: 20px 24px;
    border: 1px solid #e9e4ed;
    border-radius: 14px;
    box-shadow: 0 4px 16px rgba(48,31,68,.035);
}
.public-profile-card::before { width: 3px; background: #b99a5a; }
.public-profile-avatar {
    flex-basis: 58px;
    width: 58px;
    height: 58px;
    border: 1px solid #ece7f0;
    border-radius: 14px;
    background: #f8f6fa;
    font-size: 23px;
}
.public-profile-identity .eyebrow { margin-bottom: 4px; font-size: 10px; }
.public-profile-identity h1 { margin: 0 0 7px; font-size: clamp(24px, 2.2vw, 30px); line-height: 1.2; }
.public-profile-meta { gap: 6px; }
.public-profile-meta span { padding: 4px 9px; background: #f7f5f8; font-size: 12px; }
.public-profile-count { min-width: 128px; padding-left: 18px; font-size: 12px; }
.public-profile-count strong { font-size: 28px; }

.public-profile-section > .public-achievement-section {
    margin-top: 22px;
    padding: 20px 24px 8px;
    border: 1px solid #e9e4ed;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 4px 16px rgba(48,31,68,.035);
}
.public-achievement-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    flex-direction: row;
    gap: 20px;
    margin: 0 0 10px;
    padding-bottom: 14px;
    border-bottom: 1px solid #eeeaf2;
    text-align: left;
}
.public-achievement-heading .eyebrow { margin-bottom: 4px; font-size: 10px; }
.public-achievement-heading h2 { font-size: 24px; line-height: 1.2; }
.public-achievement-heading > p { max-width: none; margin: 0 0 2px; font-size: 13px; line-height: 1.45; }
.public-profile-achievements {
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
}
.profile-achievement-row {
    grid-template-columns: 58px minmax(0,1fr) auto;
    align-items: center;
    gap: 16px;
    padding: 15px 2px;
    border-bottom: 1px solid #eeeaf2;
}
.profile-achievement-row:last-child { border-bottom: 0; }
.profile-achievement-year { color: #756d7d; font-size: 13px; font-weight: 700; }
.profile-achievement-copy h3 { margin: 0 0 6px; font-size: 16px; }
.profile-achievement-copy .public-achievement-tags { gap: 6px; margin: 0; }
.profile-achievement-copy .public-achievement-tags span { padding: 3px 8px; background: #fff; font-size: 11px; }
.profile-achievement-copy .public-achievement-organizer { margin-top: 5px; font-size: 12px; }
.profile-achievement-action { min-width: 112px; padding: 8px 11px; border-radius: 8px; background: #fff; font-size: 12px; }

@media (max-width: 760px) {
    .public-profile-section { padding-top: 22px; padding-bottom: 36px; }
    .public-profile-card { align-items: center; gap: 12px; padding: 15px; }
    .public-profile-avatar { flex-basis: 48px; width: 48px; height: 48px; font-size: 20px; }
    .public-profile-identity { flex-basis: calc(100% - 62px); }
    .public-profile-identity h1 { font-size: 22px; }
    .public-profile-count { min-width: 0; padding: 10px 0 0; }
    .public-profile-section > .public-achievement-section { margin-top: 16px; padding: 16px 15px 5px; }
    .public-achievement-heading { align-items: flex-start; flex-direction: column; gap: 4px; padding-bottom: 11px; }
    .public-achievement-heading h2 { font-size: 22px; }
    .profile-achievement-row { grid-template-columns: 42px minmax(0,1fr); gap: 6px 11px; padding: 13px 0; }
    .profile-achievement-action { grid-column: 2; justify-self: start; }
}
/* Competition discovery pages use editorial panels and award result rows. */
.level-directory-section, .group-page-section, .group-results-section { min-height: 64vh; padding-top: clamp(52px,8vw,92px); }
.level-directory-heading { width: min(90%, 1080px); margin: 0 auto 34px; }
.level-directory-heading .eyebrow { display: block; margin-bottom: 11px; }
.level-directory-heading h1, .group-page-hero h1 { margin: 0; color: var(--purple-dark); font-size: clamp(32px,5vw,54px); letter-spacing: -.035em; line-height: 1.08; }
.level-directory-heading p, .group-page-hero p { max-width: 660px; margin: 14px 0 0; color: var(--muted); font-size: 16px; line-height: 1.7; }
.level-directory-grid { width: min(90%,1080px); margin: 0 auto; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16px; }
.level-directory-card { position: relative; display: grid; grid-template-columns: 64px minmax(0,1fr); align-items: center; gap: 20px; min-height: 188px; overflow: hidden; padding: 26px; border: 1px solid #e8def2; border-radius: 19px; background: #fff; color: inherit; text-decoration: none; box-shadow: 0 12px 32px rgba(48,31,68,.055); transition: transform .18s ease, box-shadow .18s ease; }
.level-directory-card::after { content: ''; position: absolute; width: 185px; height: 185px; right: -74px; bottom: -109px; border: 1px solid rgba(197,154,55,.2); border-radius: 50%; box-shadow: 0 0 0 18px rgba(197,154,55,.045),0 0 0 38px rgba(118,81,165,.035); }
.level-directory-card:hover { transform: translateY(-3px); box-shadow: 0 20px 40px rgba(48,31,68,.1); }
.level-directory-number { position: absolute; top: 16px; right: 20px; color: #a693b5; font-size: 11px; font-weight: 800; letter-spacing: .13em; }
.level-directory-mark { display: grid; width: 60px; height: 60px; place-items: center; border-radius: 18px; background: linear-gradient(145deg,#f1e8f8,#fff5dc); color: var(--purple-dark); font-size: 27px; font-weight: 800; }
.level-directory-content { position: relative; z-index: 1; display: grid; justify-items: start; gap: 7px; }
.level-directory-content small { color: #987db0; font-size: 9px; font-weight: 800; letter-spacing: .13em; }
.level-directory-content strong { color: var(--purple-dark); font-size: 21px; }
.level-directory-content > span { color: var(--muted); font-size: 13px; line-height: 1.5; }
.level-directory-content em { display: inline-flex; align-items: center; gap: 12px; margin-top: 4px; padding: 6px 10px; border-radius: 999px; background: #fbf5e7; color: #89641a; font-size: 11px; font-style: normal; font-weight: 750; }
.level-directory-content em b { font-size: 15px; }
.group-page-hero { width: min(90%,1080px); margin: 0 auto 38px; }
.group-page-hero .eyebrow { display: block; margin-bottom: 11px; }
.group-category-grid { width: min(90%,1080px); margin: 0 auto; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 18px; }
.group-category-card { position: relative; display: flex; min-height: 380px; flex-direction: column; justify-content: space-between; overflow: hidden; padding: 26px 30px 24px; border: 1px solid rgba(255,255,255,.5); border-radius: 22px; color: #fff; text-decoration: none; box-shadow: 0 20px 46px rgba(48,31,68,.14); transition: transform .2s ease, box-shadow .2s ease; }
.group-category-academic { background: linear-gradient(145deg,#45265e 0%,#67408d 57%,#8960aa 100%); }
.group-category-nonacademic { background: linear-gradient(145deg,#6b4a16 0%,#a17b2e 58%,#c59a37 100%); }
.group-category-card:hover { transform: translateY(-4px); box-shadow: 0 25px 54px rgba(48,31,68,.2); }
.group-category-topline, .group-category-link { position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; font-size: 11px; font-weight: 750; letter-spacing: .1em; text-transform: uppercase; }
.group-category-topline span:last-child { display: grid; width: 34px; height: 34px; place-items: center; border: 1px solid rgba(255,255,255,.35); border-radius: 50%; font-size: 17px; }
.group-category-watermark { position: absolute; right: 14px; top: 42px; color: rgba(255,255,255,.08); font-size: clamp(180px,26vw,280px); font-weight: 850; line-height: .9; pointer-events: none; }
.group-category-copy { position: relative; z-index: 2; max-width: 400px; }
.group-category-copy > span { color: rgba(255,255,255,.72); font-size: 12px; letter-spacing: .04em; }
.group-category-copy h2 { margin: 8px 0 10px; color: #fff; font-size: clamp(30px,4vw,42px); }
.group-category-copy p { max-width: 340px; margin: 0 0 24px; color: rgba(255,255,255,.82); line-height: 1.6; }
.group-category-copy strong { display: inline-flex; align-items: baseline; gap: 7px; color: #fff; font-size: 26px; }
.group-category-copy strong small { color: rgba(255,255,255,.73); font-size: 12px; font-weight: 500; }
.group-category-link { padding-top: 17px; border-top: 1px solid rgba(255,255,255,.22); letter-spacing: .04em; text-transform: none; }
.group-category-link b { display: grid; width: 32px; height: 32px; place-items: center; border-radius: 50%; background: rgba(255,255,255,.16); font-size: 16px; }
.group-results-hero, .group-results-list { width: min(90%,1080px); margin-inline: auto; }
.group-results-hero { margin-bottom: 26px; }
.group-results-hero .public-profile-back { margin-bottom: 22px; }
.group-results-hero > .eyebrow { display: block; margin-bottom: 9px; }
.group-results-title-row { display: flex; align-items: end; justify-content: space-between; gap: 20px; }
.group-results-title-row h1 { margin: 0; color: var(--purple-dark); font-size: clamp(32px,5vw,52px); letter-spacing: -.03em; }
.group-results-title-row p { max-width: 630px; margin: 10px 0 0; color: var(--muted); line-height: 1.6; }
.group-results-total { display: grid; justify-items: end; gap: 2px; color: var(--muted); font-size: 12px; white-space: nowrap; }
.group-results-total strong { color: var(--purple-dark); font-size: 28px; }
.group-results-list { overflow: hidden; border: 1px solid #e8def2; border-radius: 18px; background: rgba(255,255,255,.97); box-shadow: 0 16px 40px rgba(48,31,68,.065); }
.group-result-row { display: grid; grid-template-columns: 68px minmax(220px,1fr) minmax(170px,auto) 115px; align-items: center; gap: 20px; padding: 20px 24px; border-bottom: 1px solid #eee8f3; color: inherit; text-decoration: none; transition: background .16s ease; }
.group-result-row:last-child { border-bottom: 0; }
.group-result-row:hover { background: #fbf8fd; }
.group-result-year { color: #9a83ad; font-size: 14px; font-weight: 750; }
.group-result-copy { display: grid; gap: 6px; min-width: 0; }
.group-result-copy strong { overflow: hidden; color: var(--purple-dark); font-size: 16px; text-overflow: ellipsis; white-space: nowrap; }
.group-result-copy > span { overflow: hidden; color: var(--muted); font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }
.group-result-tags { display: flex; flex-wrap: wrap; gap: 6px; }
.group-result-tags i { padding: 6px 9px; border: 1px solid #eee6f4; border-radius: 999px; color: #78618a; font-size: 10px; font-style: normal; white-space: nowrap; }
.group-result-open { display: flex; align-items: center; justify-content: end; gap: 9px; color: var(--purple-dark); font-size: 12px; font-weight: 750; white-space: nowrap; }
.group-result-open b { display: grid; width: 30px; height: 30px; place-items: center; border: 1px solid #e5d8ef; border-radius: 50%; color: #9a7627; font-size: 14px; }
.group-results-empty { width: min(90%,1080px); margin-inline: auto; }
.group-showcase-section { padding-top: clamp(38px,5vw,56px); padding-bottom: clamp(38px,5vw,56px); background: #fff; }
.group-showcase-heading { width: min(90%,1160px); margin: 0 auto 18px; display: flex; align-items: end; justify-content: space-between; gap: 18px; }
.group-showcase-heading .eyebrow { display: block; margin-bottom: 7px; }
.group-showcase-heading h2 { margin: 0; color: var(--purple-dark); font-size: clamp(25px,3vw,34px); }
.group-showcase-all { display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px; border: 1px solid #e8e0ef; border-radius: 9px; color: var(--purple-dark); background: #fff; font-size: 13px; font-weight: 700; text-decoration: none; transition: border-color .18s ease, background .18s ease; }
.group-showcase-all:hover { border-color: #cfc0df; background: #faf8fc; }
.group-showcase-grid { width: min(90%,1160px); margin: 0 auto; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16px; }
.group-showcase-card { position: relative; display: grid; min-height: 174px; align-content: center; gap: 16px; overflow: hidden; padding: 23px 26px; border: 1px solid #e8e2ed; border-left: 3px solid var(--purple); border-radius: 13px; color: var(--purple-dark); background: #fff; text-decoration: none; box-shadow: 0 5px 18px rgba(48,31,68,.045); transition: border-color .18s ease, box-shadow .18s ease, background .18s ease; }
.group-showcase-nonacademic { border-left-color: #c39a46; }
.group-showcase-card:hover { border-color: #d7c9e5; background: #fdfcff; box-shadow: 0 9px 24px rgba(48,31,68,.08); }
.group-showcase-index { position: absolute; top: 18px; right: 19px; color: #9a8da8; font-size: 11px; font-weight: 750; letter-spacing: .08em; font-variant-numeric: tabular-nums; }
.group-showcase-copy { display: grid; gap: 7px; }
.group-showcase-copy small { color: var(--purple); font-size: 10px; font-weight: 750; letter-spacing: .1em; }
.group-showcase-nonacademic .group-showcase-copy small { color: #98712c; }
.group-showcase-copy strong { color: var(--purple-dark); font-size: 23px; line-height: 1.2; }
.group-showcase-copy > span { display: inline-flex; width: fit-content; align-items: center; gap: 9px; padding: 7px 10px; border: 1px solid #eee9f2; border-radius: 7px; color: #675b72; background: #faf9fb; font-size: 12px; }
.group-showcase-copy b { color: var(--purple); font-size: 14px; }
@media (max-width: 760px) {
    .level-directory-grid, .group-category-grid, .group-showcase-grid { grid-template-columns: 1fr; }
    .level-directory-card { min-height: 160px; grid-template-columns: 52px minmax(0,1fr); gap: 14px; padding: 20px; }
    .level-directory-mark { width: 48px; height: 48px; border-radius: 14px; font-size: 22px; }
    .group-category-card { min-height: 340px; padding: 22px; }
    .group-results-title-row { align-items: start; flex-direction: column; }
    .group-results-total { justify-items: start; }
    .group-result-row { grid-template-columns: 42px minmax(0,1fr) auto; gap: 8px 12px; padding: 16px; }
    .group-result-tags { grid-column: 2; }
    .group-result-open { grid-column: 3; grid-row: 1 / span 2; font-size: 0; }
    .group-result-open b { font-size: 14px; }
    .group-showcase-heading { align-items: start; flex-direction: column; }
    .group-showcase-card { min-height: 150px; padding: 20px; }
}
/* Refined landing achievement cards: grounded, editorial, and calm. */
.recent-grid .recent-card {
    border: 1px solid rgba(87, 53, 139, .12);
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 5px 16px rgba(48, 31, 68, .055);
    transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
}

.recent-grid .recent-card::before {
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, var(--gold), #ead9a9 48%, rgba(201, 164, 94, .12));
}

.recent-grid .recent-card:hover {
    transform: translateY(-2px);
    border-color: rgba(201, 164, 94, .52);
    box-shadow: 0 10px 24px rgba(48, 31, 68, .09);
}

.recent-grid .prestasi-photo {
    margin-bottom: 22px;
    background: #f4f0f7;
}

.recent-grid .recent-card h3 {
    margin-bottom: 10px;
    letter-spacing: -.2px;
}

.recent-grid .recent-card-action {
    margin-top: 20px;
    padding-top: 15px;
    border-top-color: rgba(87, 53, 139, .1);
}

@media (prefers-reduced-motion: reduce) {
    .recent-grid .recent-card { transition: none; }
}

/* Clean information hierarchy on public achievement details and catalogs. */
.achievement-detail-header {
    align-items: center;
    padding-bottom: 24px;
}

.achievement-detail-header > div:first-child { max-width: 760px; }
.achievement-detail-header p { margin-top: 10px; }

.achievement-detail-block,
.achievement-evidence-panel {
    border-color: #e9e3ef;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 4px 14px rgba(48, 31, 68, .045);
}

.achievement-detail-block-heading > span {
    border-color: #eee8f4;
    background: #f7f4fa;
}

.achievement-detail-facts > div { border-top-color: #eeeaf2; }

.achievement-participant {
    border: 1px solid #eee8f4;
    border-radius: 12px;
    background: #fbfaff;
}

.achievement-evidence-image img {
    border-radius: 10px;
    object-fit: cover;
}

.catalog-table-wrap {
    border: 1px solid #e9e3ef;
    border-radius: 14px;
    box-shadow: 0 4px 14px rgba(48, 31, 68, .04);
}

.catalog-table th {
    background: #f7f5f9;
    color: #514563;
    letter-spacing: .02em;
}

.catalog-table td { border-bottom-color: #eeeaf2; }
.catalog-table tbody tr:nth-child(even) { background: #fcfbfd; }
.catalog-table tbody tr:hover { background: #f8f5fb; }

/* Hero image runs flush across the page instead of sitting in a rounded frame. */
.hero-slider {
    width: 100%;
    max-width: none;
    margin: 26px 0 0;
    border-right: 0;
    border-left: 0;
    border-radius: 0;
    box-shadow: none;
}

/* Wider, more grounded public catalogs with clearer type hierarchy. */
.level-directory-heading,
.level-directory-grid,
.group-page-hero,
.group-results-hero,
.group-results-list,
.group-results-empty {
    width: min(94%, 1320px);
}

.group-results-hero { margin-bottom: 24px; }
.group-results-title-row { align-items: center; }
.group-results-title-row h1 { line-height: 1.12; }
.group-results-title-row p { margin-top: 12px; font-size: 16px; }
.group-results-total {
    min-width: 150px;
    justify-items: center;
    padding: 13px 18px;
    border: 1px solid #e9e3ef;
    border-radius: 14px;
    background: rgba(255,255,255,.82);
}
.group-results-total strong { font-size: 26px; line-height: 1.1; }
.group-results-total span { font-size: 12px; }

.group-results-list {
    border-color: #e4dce9;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 5px 18px rgba(48,31,68,.045);
}
.group-result-row {
    grid-template-columns: 88px minmax(280px,1fr) minmax(190px,auto) 132px;
    gap: 24px;
    min-height: 126px;
    padding: 24px 30px;
    border-bottom-color: #ece7ef;
}
.group-result-row:hover { background: #f9f7fb; }
.group-result-year { color: #5e4b71; font-size: 15px; }
.group-result-copy { gap: 8px; }
.group-result-copy strong { font-size: 18px; letter-spacing: -.01em; }
.group-result-copy > span { color: #70647d; font-size: 14px; }
.group-result-tags { gap: 8px; }
.group-result-tags i {
    padding: 7px 11px;
    border-color: #e7dfed;
    background: #faf8fc;
    color: #5e4b71;
    font-size: 11px;
}
.group-result-open { font-size: 13px; }
.group-result-open b { width: 34px; height: 34px; }

@media (max-width: 760px) {
    .level-directory-heading,
    .level-directory-grid,
    .group-page-hero,
    .group-results-hero,
    .group-results-list,
    .group-results-empty { width: min(92%, 1320px); }
    .group-result-row {
        grid-template-columns: 48px minmax(0,1fr) auto;
        gap: 10px 14px;
        min-height: 0;
        padding: 18px;
    }
    .group-result-copy strong { font-size: 16px; }
    .group-result-copy > span { font-size: 13px; }
    .group-result-tags { grid-column: 2; }
    .group-result-open { grid-column: 3; grid-row: 1 / span 2; }
}

/* Compact public category directory: clean, readable, and consistent with SIPRESKA. */
.group-page-section {
    min-height: 0;
    padding-top: clamp(34px, 5vw, 58px);
    padding-bottom: clamp(42px, 6vw, 72px);
}
.group-showcase-heading,
.group-showcase-grid { width: min(94%, 1320px); }
.group-showcase-section { padding-top: clamp(34px, 4vw, 48px); padding-bottom: clamp(38px, 5vw, 58px); }
.group-showcase-heading { margin-bottom: 16px; }
.group-showcase-card {
    min-height: 152px;
    align-content: center;
    gap: 12px;
    padding: 20px 22px;
    border-radius: 14px;
    box-shadow: 0 5px 18px rgba(48,31,68,.045);
}
.group-showcase-card:hover { transform: none; box-shadow: 0 9px 24px rgba(48,31,68,.075); }
.group-showcase-copy { gap: 6px; }
.group-showcase-copy small { font-size: 9px; letter-spacing: .09em; }
.group-showcase-copy strong { font-size: 21px; }
.group-showcase-copy > span { padding: 6px 9px; font-size: 11px; }
.group-page-hero { width: min(94%, 1320px); margin: 0 auto 22px; }
.group-page-hero .eyebrow { margin-bottom: 8px; }
.group-page-hero p { margin-top: 10px; }
.group-category-grid {
    width: min(94%, 1320px);
    margin: 0 auto;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
}
.group-category-card {
    display: grid;
    min-height: 220px;
    align-content: space-between;
    gap: 22px;
    padding: 20px 22px 16px;
    border: 1px solid #e8e2ed;
    border-left: 3px solid var(--purple);
    border-radius: 14px;
    color: var(--purple-dark);
    background: #fff;
    box-shadow: 0 5px 18px rgba(48,31,68,.045);
    transition: border-color .18s ease, box-shadow .18s ease, background .18s ease;
}
.group-category-academic,
.group-category-nonacademic { background: #fff; }
.group-category-nonacademic { border-left-color: #c39a46; }
.group-category-card:hover {
    transform: none;
    border-color: #d8cbe5;
    border-left-color: var(--purple);
    background: #fdfcff;
    box-shadow: 0 9px 24px rgba(48,31,68,.075);
}
.group-category-card.group-category-nonacademic:hover { border-left-color: #c39a46; }
.group-category-topline {
    color: #89739d;
    font-size: 10px;
    letter-spacing: .09em;
}
.group-category-topline span:last-child {
    width: 30px;
    height: 30px;
    border-color: #e8e1ed;
    color: #98712c;
    font-size: 15px;
}
.group-category-copy { max-width: 620px; }
.group-category-copy > span {
    color: #88769a;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .035em;
}
.group-category-copy h2 {
    margin: 5px 0 6px;
    color: var(--purple-dark);
    font-size: clamp(23px, 2.5vw, 29px);
    line-height: 1.2;
}
.group-category-copy p {
    max-width: 520px;
    margin: 0 0 12px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.55;
}
.group-category-copy strong {
    gap: 6px;
    color: var(--purple-dark);
    font-size: 20px;
}
.group-category-copy strong small {
    color: var(--muted);
    font-size: 12px;
}
.group-category-link {
    padding-top: 12px;
    border-top-color: #eee9f2;
    color: var(--purple-dark);
    font-size: 12px;
    letter-spacing: 0;
}
.group-category-link b {
    width: 28px;
    height: 28px;
    border: 1px solid #eee7f3;
    background: #faf8fc;
    color: #98712c;
    font-size: 14px;
}
@media (max-width: 760px) {
    .group-showcase-heading,
    .group-showcase-grid { width: min(92%, 1320px); }
    .group-showcase-card { min-height: 136px; padding: 18px; }
    .group-category-grid { grid-template-columns: 1fr; }
    .group-category-card { min-height: 205px; gap: 18px; padding: 18px 18px 14px; }
}

/* Shared compact list/table rhythm for public achievement pages. */
.catalog-table-wrap,
body .sp-results-table-wrap {
    border: 1px solid #e4dce9;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 5px 18px rgba(48,31,68,.045);
}

.catalog-table th,
.catalog-table td,
body .sp-results-table th,
body .sp-results-table td {
    padding: 12px 18px;
    border-bottom: 1px solid #ece7ef;
    vertical-align: middle;
}

.catalog-table th,
body .sp-results-table th {
    background: #f7f5f9;
    color: #514563;
    font-size: 12px;
    font-weight: 750;
}

.catalog-table td,
body .sp-results-table td {
    color: #594f65;
    font-size: 13px;
}

.catalog-table tbody tr:nth-child(even),
body .sp-results-table tbody tr:nth-child(even) { background: #fcfbfd; }
.catalog-table tbody tr:hover,
body .sp-results-table tbody tr:hover { background: #f8f5fb; }
.catalog-table tbody tr:last-child td,
body .sp-results-table tbody tr:last-child td { border-bottom: 0; }

.group-result-row {
    min-height: 108px;
    padding: 18px 28px;
    gap: 20px;
}

.group-result-copy strong { font-size: 17px; }
.group-result-copy > span { font-size: 13px; }
.group-result-tags i { padding: 6px 10px; }
.group-result-open b { width: 32px; height: 32px; }

@media (max-width: 760px) {
    .catalog-table th,
    .catalog-table td,
    body .sp-results-table th,
    body .sp-results-table td { padding: 10px 13px; }

    .group-result-row { min-height: 0; padding: 16px; gap: 8px 12px; }
}

/* Match participant directories to the compact public achievement lists. */
.participant-directory-section {
    padding-top: 48px;
}

.participant-directory-section > .section-heading {
    margin-bottom: 20px;
}

.participant-directory {
    width: min(94%, 1320px);
    padding: 6px 26px;
    border-color: #e4dce9;
    border-radius: 16px;
    box-shadow: 0 5px 18px rgba(48,31,68,.045);
}

.participant-card {
    grid-template-columns: 48px minmax(0,1fr) minmax(160px,auto);
    gap: 18px;
    min-height: 92px;
    padding: 15px 8px;
}

.participant-card-avatar {
    width: 46px;
    height: 46px;
    border-radius: 13px;
    font-size: 18px;
}

.participant-card-role { font-size: 9px; }
.participant-card-main h2 { margin: 3px 0 5px; font-size: 17px; }
.participant-card-meta { min-height: 17px; font-size: 12px; }
.participant-card-side { min-width: 168px; }
.participant-card-side strong { font-size: 18px; }
.participant-card-side .catalog-detail-link { padding: 8px 11px; }

@media (max-width: 760px) {
    .participant-directory-section { padding-top: 38px; }
    .participant-directory-section > .section-heading { margin-bottom: 16px; }
    .participant-directory { width: min(92%, 1320px); padding: 4px 15px; }
    .participant-card { min-height: 0; padding: 14px 2px; gap: 10px 13px; }
    .participant-card-avatar { width: 42px; height: 42px; }
}

.achievement-detail-section { padding-top: 54px; }
.achievement-detail-section .public-profile-back { margin-bottom: 7px; }
.achievement-detail-section .achievement-detail-header { padding-top: 0; }

/* Tighten excessive vertical spacing on competition directory headings. */
.participant-directory-section { padding-top: 34px; }
.participant-directory-section > .section-heading { margin-bottom: 16px; }
.participant-directory-section > .section-heading .eyebrow {
    display: block;
    margin: 0 0 5px;
}
.participant-directory-section > .section-heading h1 {
    margin: 0;
    color: var(--purple-dark);
    font-size: clamp(30px, 4vw, 40px);
    line-height: 1.12;
    letter-spacing: -.025em;
}
.participant-directory-section > .section-heading p {
    margin: 8px auto 0;
    line-height: 1.5;
}

.group-results-section { padding-top: 34px; }
.group-results-hero .public-profile-back { margin-bottom: 8px; }
.group-results-hero > .eyebrow { margin-bottom: 5px; }
.group-results-title-row p { margin-top: 8px; }

/* Compact public profile and detail layouts; keep evidence aligned with content. */
.public-profile-section { padding-top: 34px; padding-bottom: 58px; }
.public-profile-section > .public-profile-heading,
.public-profile-section > .public-achievement-section { width: min(94%, 1360px); }
.public-profile-back { margin-bottom: 10px; }
.public-profile-card { min-height: 0; gap: 16px; padding: 18px 24px; border-radius: 16px; box-shadow: 0 6px 20px rgba(48,31,68,.045); }
.public-profile-avatar { flex-basis: 58px; width: 58px; height: 58px; font-size: 23px; border-radius: 15px; }
.public-profile-identity .eyebrow { margin-bottom: 4px; }
.public-profile-identity h1 { margin-bottom: 7px; font-size: clamp(24px, 2.3vw, 30px); line-height: 1.2; }
.public-profile-meta { gap: 6px; }
.public-profile-meta span { padding: 4px 9px; font-size: 12px; }
.public-profile-count { min-width: 112px; padding-left: 15px; font-size: 12px; }
.public-profile-count strong { font-size: 25px; }
.public-achievement-section { margin-top: 22px; }
.public-achievement-heading { align-items: flex-start; flex-direction: column; gap: 5px; margin-bottom: 14px; }
.public-achievement-heading > p { max-width: none; margin: 0; line-height: 1.5; }
.public-profile-achievements { padding: 2px 18px; border-radius: 15px; box-shadow: 0 6px 20px rgba(48,31,68,.045); }
.profile-achievement-row { padding: 9px 4px; gap: 12px; }
.profile-achievement-year { align-self: center; padding-top: 0; }
.profile-achievement-copy h3 { margin-bottom: 3px; font-size: 15px; line-height: 1.25; }
.profile-achievement-copy .public-achievement-tags { gap: 5px; margin-bottom: 2px; }
.profile-achievement-copy .public-achievement-tags span { padding: 2px 7px; font-size: 10px; }
.profile-achievement-copy .public-achievement-organizer { margin-top: 2px; line-height: 1.3; }
.profile-achievement-action { min-width: 0; padding: 6px 9px; font-size: 11px; }

/* Keep public result lists dense and aligned, like a real data directory. */
.group-results-list { border-radius: 15px; box-shadow: 0 6px 20px rgba(48,31,68,.045); }
.group-result-row { min-height: 0; padding: 13px 22px; gap: 14px; }
.participant-directory { padding: 4px 22px; border-radius: 15px; box-shadow: 0 6px 20px rgba(48,31,68,.045); }
.participant-card { min-height: 0; padding: 11px 6px; gap: 14px; }
.catalog-table-wrap { border-radius: 13px; }
.catalog-table th, .catalog-table td,
body .sp-results-table th, body .sp-results-table td { padding-block: 10px; }

.achievement-detail-section { padding-top: 30px; padding-bottom: 48px; }
.achievement-detail-shell { width: min(94%, 1360px); margin-inline: auto; }
.achievement-detail-section .public-profile-back { margin-bottom: 5px; }
.achievement-detail-header { padding: 0 0 18px; }
.achievement-detail-header .eyebrow { margin-bottom: 5px; }
.achievement-detail-header p { margin-top: 6px; line-height: 1.45; }
.achievement-detail-layout { grid-template-columns: minmax(0, 1.4fr) minmax(320px, .8fr); align-items: start; gap: 18px; }
.achievement-detail-main { gap: 12px; }
.achievement-detail-block,
.achievement-evidence-panel { padding: clamp(18px, 2.4vw, 24px); }
.achievement-detail-block-heading { gap: 11px; margin-bottom: 14px; }
.achievement-detail-facts > div { padding: 11px 0; }
.achievement-description-block > p { line-height: 1.6; }
.achievement-evidence-panel { height: fit-content; }
.achievement-evidence-heading { margin-bottom: 14px; }
.achievement-evidence-grid { gap: 9px; }
.achievement-evidence-image img { max-height: 190px; }

@media (max-width: 760px) {
    .participant-directory-section,
    .group-results-section { padding-top: 28px; }
    .participant-directory-section > .section-heading { margin-bottom: 14px; }
    .public-profile-section,
    .achievement-detail-section { padding-top: 26px; padding-bottom: 42px; }
    .public-profile-card { align-items: center; gap: 12px; padding: 16px; }
    .public-achievement-section { margin-top: 20px; }
    .public-achievement-heading { gap: 6px; }
    .public-profile-achievements { padding-inline: 14px; }
    .profile-achievement-row { padding-block: 9px; }
    .group-result-row { padding: 11px 14px; }
    .participant-directory { padding-inline: 14px; }
    .participant-card { padding-block: 10px; }
    .achievement-detail-layout { align-items: start; gap: 12px; }
    .achievement-detail-shell { width: min(92%, 1360px); }
    .achievement-evidence-panel { height: auto; }
}

/* Keep the achievement title, details, and evidence together as one record. */
.achievement-detail-card {
    overflow: hidden;
    border: 1px solid #e9e1f0;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 8px 26px rgba(48, 31, 68, .055);
}
.achievement-detail-section .achievement-detail-header {
    padding: 22px 28px 18px;
    border-bottom: 1px solid #eee8f3;
}
.achievement-detail-section .achievement-detail-layout {
    grid-template-columns: minmax(0, 1.4fr) minmax(300px, .8fr);
    align-items: stretch;
    gap: 0;
}

/* Refined public group-results directory */
.group-results-section {
    padding-top: 28px;
    padding-bottom: clamp(176px, 15vw, 208px);
}
.group-results-hero,
.group-results-search,
.group-results-list,
.group-results-empty {
    width: min(94%, 1360px);
}
.group-results-hero {
    margin-bottom: 18px;
}
.group-results-search {
    position: relative;
    display: flex;
    align-items: center;
    margin: 0 auto 14px;
    padding: 0 16px;
    min-height: 52px;
    border: 1px solid #e7e1eb;
    border-radius: 13px;
    background: #fff;
    box-shadow: 0 4px 14px rgba(48,31,68,.035);
    transition: border-color .18s ease, box-shadow .18s ease;
}
.group-results-search:focus-within {
    border-color: #9d78c8;
    box-shadow: 0 0 0 3px rgba(116,75,159,.1);
}
.group-results-search svg {
    width: 19px;
    height: 19px;
    flex: 0 0 auto;
    fill: none;
    stroke: #68419a;
    stroke-width: 1.8;
    stroke-linecap: round;
}
.group-results-search input {
    width: 100%;
    min-width: 0;
    height: 50px;
    padding: 0 12px;
    border: 0;
    outline: 0;
    color: #352847;
    background: transparent;
    font: inherit;
    font-size: 14px;
}
.group-results-search input::placeholder { color: #93889f; }
.group-results-no-match {
    width: min(94%, 1360px);
    margin: 14px auto 0;
    padding: 18px;
    border: 1px dashed #d9cce7;
    border-radius: 12px;
    color: #756985;
    text-align: center;
    background: rgba(255,255,255,.62);
}
.group-result-row[hidden] { display: none; }
.group-results-hero .public-profile-back {
    margin-bottom: 10px;
}
.group-results-title-row {
    align-items: center;
    gap: 24px;
}
.group-results-title-row h1 {
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.12;
}
.group-results-title-row p {
    max-width: 720px;
    margin-top: 7px;
    line-height: 1.45;
}
.group-results-total {
    min-width: 142px;
    padding: 10px 16px;
    border: 1px solid #e9e1f0;
    border-radius: 14px;
    background: #fff;
    justify-items: center;
}
.group-results-total strong {
    font-size: 24px;
    line-height: 1.1;
}
.group-results-list {
    border-color: #e7e1eb;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 5px 18px rgba(48,31,68,.04);
}
.group-result-row {
    grid-template-columns: 68px minmax(240px, 1fr) minmax(190px, 240px) 112px;
    gap: 18px;
    min-height: 0;
    padding: 15px 22px;
    border-bottom-color: #eeeaf1;
}
.group-result-row:hover {
    background: #faf9fb;
}
.group-result-year {
    font-size: 14px;
    font-variant-numeric: tabular-nums;
}
.group-result-copy {
    gap: 4px;
}
.group-result-copy strong {
    font-size: 16px;
    line-height: 1.3;
}
.group-result-copy > span {
    font-size: 12px;
    line-height: 1.35;
}
.group-result-tags {
    align-items: center;
    gap: 6px;
}
.group-result-tags i {
    padding: 5px 9px;
    border-color: #ebe5ef;
    background: #fbfafd;
    font-size: 10px;
}
.group-result-open {
    gap: 7px;
    font-size: 12px;
}
.group-result-open b {
    width: 28px;
    height: 28px;
}
@media (max-width: 760px) {
    .group-results-section { padding-top: 24px; padding-bottom: 144px; }
    .group-results-title-row { gap: 14px; }
    .group-results-total { min-width: 0; padding: 8px 12px; }
    .group-results-total strong { font-size: 21px; }
    .group-result-row {
        grid-template-columns: 44px minmax(0, 1fr) auto;
        gap: 7px 12px;
        padding: 13px 14px;
    }
    .group-result-tags { grid-column: 2; }
    .group-result-open { grid-column: 3; grid-row: 1 / span 2; }
}
.achievement-detail-main {
    display: grid;
    align-content: start;
    gap: 0;
    padding: 0 26px;
}
.achievement-detail-main .achievement-detail-block {
    padding: 20px 0;
    border: 0;
    border-bottom: 1px solid #eee8f3;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
}
.achievement-detail-main > .achievement-detail-block:last-child { border-bottom: 0; }
.achievement-detail-block-heading { margin-bottom: 13px; }
.achievement-detail-facts > div { padding: 10px 0; }

/* Compact visual cues for the public achievement group directory. */
.group-results-title-row h1 {
    display: flex;
    align-items: center;
    gap: 12px;
}
.group-results-title-row h1 svg {
    width: 32px;
    height: 32px;
    flex: 0 0 32px;
    padding: 6px;
    border: 1px solid #e9def3;
    border-radius: 10px;
    background: #fff;
    fill: none;
    stroke: #7650a5;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
}
.group-result-tags i {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    line-height: 1.2;
}
.group-result-tags i svg {
    width: 12px;
    height: 12px;
    flex: 0 0 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
}
.group-result-tags .group-result-tag-rank svg { color: #a87920; }
@media (max-width: 760px) {
    .group-results-title-row h1 { gap: 9px; }
    .group-results-title-row h1 svg { width: 28px; height: 28px; flex-basis: 28px; }
}
.achievement-detail-section .achievement-evidence-panel {
    height: auto;
    padding: 22px 24px;
    border: 0;
    border-left: 1px solid #eee8f3;
    border-radius: 0;
    background: #fbf9fd;
    box-shadow: none;
}
.achievement-evidence-heading { margin-bottom: 13px; }
.achievement-evidence-grid { gap: 10px; }
.achievement-evidence-image {
    padding: 7px;
    border: 1px solid #ebe4f0;
    border-radius: 12px;
    background: #fff;
}
.achievement-evidence-image img {
    max-height: 240px;
    object-fit: contain;
    background: #f6f3f8;
}

@media (max-width: 760px) {
    .achievement-detail-section .achievement-detail-header { padding: 19px 18px 15px; }
    .achievement-detail-main { padding-inline: 18px; }
    .achievement-detail-main .achievement-detail-block { padding-block: 17px; }
    .achievement-detail-section .achievement-evidence-panel {
        padding: 18px;
        border-top: 1px solid #eee8f3;
        border-left: 0;
    }
}

/* Make public profiles and their achievement history read as one clean record. */
.public-profile-section { padding-top: 34px; padding-bottom: 54px; }
.public-profile-heading,
.public-achievement-section { width: min(94%, 1360px); }
.public-profile-back { margin-bottom: 12px; }
.public-profile-card {
    gap: 20px;
    padding: 22px 28px;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 6px 20px rgba(48,31,68,.045);
}
.public-profile-avatar { flex-basis: 64px; width: 64px; height: 64px; }
.public-profile-identity .eyebrow { margin-bottom: 5px; }
.public-profile-identity h1 { margin-bottom: 8px; line-height: 1.15; }
.public-profile-count { min-width: 132px; }
.public-profile-count strong { font-size: 30px; }
.public-achievement-section { margin-top: 28px; }
.public-achievement-heading { align-items: flex-start; flex-direction: column; gap: 5px; margin-bottom: 12px; text-align: left; }
.public-achievement-heading > p { max-width: 420px; line-height: 1.45; }
.public-profile-achievements {
    padding: 0 22px;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 6px 20px rgba(48,31,68,.045);
}
.profile-achievement-row { padding: 15px 2px; }
.profile-achievement-year { align-self: center; padding-top: 0; }
.profile-achievement-copy h3 { margin-bottom: 5px; line-height: 1.3; }
.profile-achievement-copy .public-achievement-organizer { margin-top: 3px; }
.profile-achievement-copy .public-achievement-tags { gap: 6px; }
.profile-achievement-copy .public-achievement-tags span { background: #fff; }
.profile-achievement-action { background: #fff; }

/* Keep documentation on the same white surface as the achievement details. */
.achievement-detail-section .achievement-evidence-panel { background: #fff; }
.achievement-evidence-image { background: #fff; }
.achievement-evidence-image img { background: #fff; }

/* Align the fact separators into an even two-column rhythm. */
.achievement-detail-section .achievement-detail-facts {
    column-gap: 28px;
    row-gap: 0;
}
.achievement-detail-section .achievement-detail-facts > div {
    display: flex;
    min-height: 70px;
    flex-direction: column;
    justify-content: center;
    padding: 12px 0;
    border-top: 0;
    border-bottom: 1px solid #eeeaf2;
}
.achievement-detail-section .achievement-detail-facts > div:nth-last-child(-n+2) { border-bottom: 0; }
.achievement-detail-section .achievement-detail-fact-wide { grid-column: auto; }
.achievement-detail-section .achievement-detail-main .achievement-detail-block {
    border-bottom-color: #e9e4ed;
}
.achievement-detail-section .achievement-detail-block-heading > span {
    border-color: #ece7f0;
    background: #faf9fb;
}
.achievement-detail-section .achievement-evidence-image {
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
}
.achievement-detail-section .achievement-evidence-image img {
    border-color: #e9e4ed;
    border-radius: 10px;
}
.achievement-detail-section .achievement-evidence-image span { padding-inline: 2px; }

@media (max-width: 760px) {
    .achievement-detail-section .achievement-detail-facts { column-gap: 18px; }
    .achievement-detail-section .achievement-detail-facts > div { min-height: 64px; }
    .public-profile-section { padding-top: 26px; padding-bottom: 42px; }
    .public-profile-heading,
    .public-achievement-section { width: min(92%, 1360px); }
    .public-profile-card { align-items: center; gap: 12px; padding: 16px; }
    .public-profile-avatar { flex-basis: 48px; width: 48px; height: 48px; border-radius: 14px; font-size: 22px; }
    .public-profile-identity h1 { font-size: clamp(22px, 6vw, 30px); }
    .public-achievement-section { margin-top: 22px; }
    .public-achievement-heading { align-items: flex-start; gap: 4px; margin-bottom: 10px; text-align: left; }
    .public-achievement-heading > p { margin-top: 2px; }
    .public-profile-achievements { padding-inline: 14px; }
    .profile-achievement-row { grid-template-columns: 42px minmax(0,1fr); gap: 8px 12px; padding-block: 12px; }
    .profile-achievement-action { grid-column: 2; justify-self: start; }
}

/* Final visual refinement for the public achievement detail page. */
.achievement-detail-section {
    padding: 24px 0 48px;
}
.achievement-detail-shell {
    width: min(92%, 1240px);
}
.achievement-detail-section .public-profile-back {
    margin: 0 0 12px;
    line-height: 1.4;
}
.achievement-detail-card {
    overflow: hidden;
    border: 1px solid #e9e2ef;
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 14px 38px rgba(48, 31, 68, .07);
}
.achievement-detail-section .achievement-detail-header {
    padding: 24px 30px 20px;
    border-bottom: 1px solid #eee8f2;
    background: linear-gradient(110deg, #fff 0%, #fdfbff 100%);
}
.achievement-detail-section .achievement-detail-header .eyebrow {
    margin-bottom: 6px;
}
.achievement-detail-section .achievement-detail-header h1 {
    font-size: clamp(30px, 3.2vw, 40px);
    line-height: 1.15;
}
.achievement-detail-section .achievement-detail-header p {
    margin-top: 7px;
    line-height: 1.55;
}
.achievement-detail-section .achievement-detail-layout {
    grid-template-columns: minmax(0, 1.35fr) minmax(300px, .8fr);
    gap: 0;
}
.achievement-detail-section .achievement-detail-main {
    gap: 0;
    padding: 8px 28px 18px;
}
.achievement-detail-section .achievement-detail-main .achievement-detail-block {
    padding: 20px 0;
    border-bottom: 1px solid #eee8f2;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
}
.achievement-detail-section .achievement-detail-main > .achievement-detail-block:last-child {
    border-bottom: 0;
}
.achievement-detail-section .achievement-detail-block-heading {
    gap: 12px;
    margin-bottom: 12px;
}
.achievement-detail-section .achievement-detail-block-heading > span {
    flex-basis: 36px;
    width: 36px;
    height: 36px;
}
.achievement-detail-section .achievement-detail-facts {
    gap: 0 22px;
}
.achievement-detail-section .achievement-detail-facts > div {
    min-height: 62px;
    justify-content: center;
    padding: 10px 0;
    border-bottom: 1px solid #f0ebf3;
}
.achievement-detail-section .achievement-detail-facts > div:nth-last-child(-n+2) {
    border-bottom: 0;
}
.achievement-detail-section .achievement-detail-fact-wide {
    grid-column: 1 / -1;
}
.achievement-detail-section .achievement-participant {
    border-color: #eee8f2;
    background: #fcfaff;
}
.achievement-detail-section .achievement-description-block > p {
    padding: 13px 15px;
    border: 1px solid #f0ebf3;
    border-radius: 12px;
    background: #fcfaff;
}
.achievement-detail-section .achievement-evidence-panel {
    align-self: stretch;
    padding: 24px 22px;
    border: 0;
    border-left: 1px solid #eee8f2;
    border-radius: 0;
    background: #fbf9fd;
    box-shadow: none;
}
.achievement-detail-section .achievement-evidence-heading {
    margin-bottom: 14px;
}
.achievement-detail-section .achievement-evidence-grid {
    gap: 12px;
}
.achievement-detail-section .achievement-evidence-image {
    display: block;
    overflow: hidden;
    padding: 7px;
    border: 1px solid #eae4ef;
    border-radius: 13px;
    background: #fff;
}
.achievement-detail-section .achievement-evidence-image img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: 220px;
    border: 0;
    border-radius: 8px;
    object-fit: cover;
    object-position: center 38%;
    background: #f4f1f6;
}
.achievement-detail-section .achievement-evidence-image span {
    display: block;
    padding: 8px 3px 1px;
    color: #665776;
    font-size: 12px;
    overflow-wrap: anywhere;
}
.achievement-detail-section .achievement-evidence-file {
    border-color: #eae4ef;
    background: #fff;
}

@media (max-width: 900px) {
    .achievement-detail-section .achievement-detail-layout {
        grid-template-columns: minmax(0, 1fr) minmax(270px, .8fr);
    }
}
@media (max-width: 760px) {
    .achievement-detail-section { padding: 18px 0 36px; }
    .achievement-detail-shell { width: min(94%, 620px); }
    .achievement-detail-section .achievement-detail-header { padding: 20px 20px 17px; }
    .achievement-detail-section .achievement-detail-layout { grid-template-columns: 1fr; }
    .achievement-detail-section .achievement-detail-main { padding: 0 20px 8px; }
    .achievement-detail-section .achievement-detail-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .achievement-detail-section .achievement-evidence-panel {
        padding: 20px;
        border-top: 1px solid #eee8f2;
        border-left: 0;
    }
}
@media (max-width: 420px) {
    .achievement-detail-section .achievement-detail-facts { grid-template-columns: 1fr; }
    .achievement-detail-section .achievement-detail-fact-wide { grid-column: auto; }
}

/* Give the achievement information fields enough room to read comfortably. */
.achievement-detail-section .achievement-detail-facts {
    row-gap: 12px;
    column-gap: 14px;
    margin-top: 16px;
}
.achievement-detail-section .achievement-detail-facts > div {
    min-height: 70px;
    justify-content: center;
    padding: 13px 15px;
    border: 1px solid #eee8f2;
    border-radius: 12px;
    background: #fcfaff;
}
.achievement-detail-section .achievement-detail-facts > div:nth-last-child(-n+2) {
    border-bottom: 1px solid #eee8f2;
}
